tested_fingerprint: "craftcms"

tests: [
  {
    name: "craftcms_3_9_15_installed_admin_login_and_cp_js"
    mock_responses: [
      {
        uri: "/admin/login"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" },
          { name: "X-Powered-By", value: "Craft CMS" },
          { name: "Set-Cookie", value: "CRAFT_CSRF_TOKEN=7e5b6833bedf70ecb6da1074f31f05d7; path=/; HttpOnly" }
        ]
        body: "<!DOCTYPE html><html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en-US\"><head><title>Sign In - Craft Test</title><script>window.Craft = {\"actionTrigger\":\"actions\",\"actionUrl\":\"http:\\/\\/target.test:8080\\/index.php?p=admin\\/actions\\/\",\"baseApiUrl\":\"https:\\/\\/api.craftcms.com\\/v1\\/\",\"cpTrigger\":\"admin\",\"csrfTokenName\":\"CRAFT_CSRF_TOKEN\",\"csrfTokenValue\":\"testtoken\"};</script></head><body class=\"login ltr\"><script src=\"http://target.test:8080/cpresources/86a45b20/garnish.js?v=1698700000\"></script><script src=\"http://target.test:8080/cpresources/7f21c3a1/cp.js?v=1698700000\"></script><script src=\"http://target.test:8080/cpresources/9b41e012/login.js?v=1698700000\"></script><script>new Craft.LoginForm();</script></body></html>"
      },
      {
        uri: "/cpresources/7f21c3a1/cp.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript; charset=utf-8" }
        ]
        body: "/*! For license information please see cp.js.LICENSE.txt */\n(function(){var __webpack_modules__={463:function(){Craft.Accordion=Garnish.Base.extend({$trigger:null});Craft.Uploader=Garnish.Base.extend({});}};})();"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
