  {
    name: "negative_blog_post_discussing_gravcms"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>Reviewing GravCMS 2.0</title><meta name=\"generator\" content=\"Hugo 0.125.0\" /><link rel=\"stylesheet\" href=\"/static/blog.css\"></head><body><article><h1>How GravCMS Works</h1><p>By default Grav renders &lt;meta name=&quot;generator&quot; content=&quot;GravCMS&quot; /&gt; and loads themes from /user/themes/quark/ and window.__GRAV_CONFIG__ on /admin.</p></article></body></html>"
      }
