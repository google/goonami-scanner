        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\" /><title>Typography | Grav</title><meta name=\"generator\" content=\"GravCMS\" /><link href=\"/user/themes/quark/css-compiled/theme.min.css\" type=\"text/css\" rel=\"stylesheet\"><script src=\"/system/assets/jquery/jquery-3.x.min.js\"></script></head><body><div id=\"page-wrapper\"><h1>Core Grav</h1></div></body></html>"
      }
    ]
