# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "gravcms"

tests: [
  {
    name: "gravcms_1_7_35_unconfigured_register_admin_at_root"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-40d1b2d-admin=8f2458fa78a92dbf3f102500bb8de613; path=/; HttpOnly; SameSite=Lax" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\" /><title>Grav Register Admin User | Grav</title><link rel=\"icon\" type=\"image/png\" href=\"/user/plugins/admin/themes/grav/images/favicon.png\"><link href=\"/user/plugins/admin/themes/grav/css-compiled/nucleus.css?91c8018700\" type=\"text/css\" rel=\"stylesheet\"><link href=\"/user/plugins/admin/themes/grav/css-compiled/template.css?91c8018700\" type=\"text/css\" rel=\"stylesheet\"><script src=\"/system/assets/jquery/jquery-3.x.min.js?91c8018700\"></script></head><body id=\"admin-login-wrapper\"><section id=\"admin-login\" class=\"default-glow-shadow\"><form method=\"post\" action=\"/admin\"><div class=\"form-data\" data-grav-field=\"text\"><input name=\"data[username]\" type=\"text\" /></div><input type=\"hidden\" name=\"__form-name__\" value=\"admin-login-register\" /></form></section></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
  {
    name: "gravcms_1_7_53_configured_frontend_and_classic_admin"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-40d1b2d=5ef0018fdeee533347421f2dca984077; path=/; HttpOnly; SameSite=Lax" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\" /><title>Home | Grav</title><meta name=\"generator\" content=\"GravCMS\" /><meta name=\"description\" content=\"Grav is an easy to use, yet powerful, open source flat-file CMS\" /><link rel=\"icon\" type=\"image/png\" href=\"/user/themes/quark/images/favicon.png\" /><link href=\"/user/plugins/login/css/login.css\" type=\"text/css\" rel=\"stylesheet\"><link href=\"/user/themes/quark/css-compiled/spectre.min.css\" type=\"text/css\" rel=\"stylesheet\"><link href=\"/user/themes/quark/css-compiled/theme.min.css\" type=\"text/css\" rel=\"stylesheet\"><script src=\"/system/assets/jquery/jquery-3.x.min.js\"></script></head><body id=\"top\"><div id=\"page-wrapper\"><h1>Grav Running!</h1></div></body></html>"
      },
      {
        uri: "/admin"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-40d1b2d-admin=3839b737f4a6c050b084f9d45f5c5ab5; path=/; HttpOnly; SameSite=Lax" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\" /><title>Grav Admin Login | Grav</title><link rel=\"icon\" type=\"image/png\" href=\"/user/plugins/admin/themes/grav/images/favicon.png\"><link href=\"/user/plugins/admin/themes/grav/css-compiled/template.css?9b9fa9f39d\" type=\"text/css\" rel=\"stylesheet\"></head><body id=\"admin-login-wrapper\"><section id=\"admin-login\" class=\"default-glow-shadow\"><form method=\"post\" action=\"/admin\"><div class=\"form-data\" data-grav-field=\"text\"><input name=\"data[username]\" type=\"text\" /></div><input type=\"hidden\" name=\"task\" value=\"login.login\" /><input type=\"hidden\" name=\"login-nonce\" value=\"a1b2c3d4\" /></form></section></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
  {
    name: "gravcms_2_0_0_unconfigured_admin2_version_extraction"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-40d1b2d=9a1b2c3d4e5f60718293a4b5c6d7e8f9; path=/; HttpOnly; SameSite=Lax" }
        ]
        body: "<!doctype html><html lang=\"en\" data-theme=\"grav\"><head><meta charset=\"utf-8\" /><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" /><link href=\"/user/plugins/admin2/app/_app/immutable/assets/0.B9x8K1a2.css\" rel=\"stylesheet\"><script>window.__GRAV_CONFIG__ = {\"serverUrl\":\"http://target.test:8080\",\"apiPrefix\":\"/api/v1\",\"basePath\":\"/admin\",\"environment\":\"production\",\"grav\":{\"version\":\"2.0.0\"},\"admin\":{\"name\":\"Admin2\",\"version\":\"2.0.1\"}};</script></head><body data-sveltekit-preload-data=\"hover\"><div style=\"display: contents\"><script type=\"module\" src=\"/user/plugins/admin2/app/_app/immutable/entry/start.C1a2B3c4.js\"></script></div></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.0.0"]
      }
    ]
  },
