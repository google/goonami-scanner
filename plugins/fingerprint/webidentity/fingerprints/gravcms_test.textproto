  {
    name: "gravcms_nginx_changelog_version_extraction"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-40d1b2d=0123456789abcdef0123456789abcdef; path=/; HttpOnly" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta name=\"generator\" content=\"GravCMS\" /><link href=\"/user/themes/quark/css-compiled/theme.min.css\" rel=\"stylesheet\"></head><body><h1>Home</h1></body></html>"
      },
      {
        uri: "/CHANGELOG.md"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/markdown; charset=utf-8" }
        ]
        body: "# v1.7.48\n## 01/15/2025\n\n1. [](#improved)\n    * Improved compatibility with PHP 8.4 [#3880](https://github.com/getgrav/grav/pull/3880)\n1. [](#bugfix)\n    * Fixed `<html lang=\"en\">` attribute escaping in `bin/grav` Twig templates\n\n# v1.7.47\n## 11/20/2024\n\n1. [](#bugfix)\n    * Fixed Twig cache issue\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["1.7.48"]
      }
    ]
  },
  {
    name: "gravcms_exposed_versions_yaml_extraction"
    mock_responses: [
      {
        uri: "/user/config/versions.yaml"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/yaml; charset=utf-8" }
        ]
        body: "core:\n  grav:\n    version: 2.2.22\n    schema: 2.0.0_2025-01-01_1\n    history:\n      - version: 2.2.22\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.2.22"]
      }
    ]
  },
  {
    name: "gravcms_2_api_auth_setup_custom_frontend"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>Acme Docs</title></head><body><h1>Custom Headless Frontend</h1></body></html>"
      },
      {
        uri: "/api/v1/auth/setup"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json" }
        ]
        body: "{\"data\":{\"setup_required\":false,\"password_policy\":{\"min_length\":8,\"rules\":[{\"id\":\"length\",\"label\":\"At least 8 characters\",\"pattern\":\".{8,}\"}]}}}"
      },
      {
        uri: "/api/v1"
        status_code: 401
        headers: [
          { name: "Content-Type", value: "application/problem+json" },
          { name: "WWW-Authenticate", value: "Bearer" }
        ]
        body: "{\"status\":401,\"title\":\"Unauthorized\",\"detail\":\"No valid authentication credentials provided. Use an API key, JWT token, or active session.\"}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
  {
    name: "gravcms_subpath_via_login_page_and_changelog"
    mock_responses: [
      {
        uri: "/cms/login"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=UTF-8" },
          { name: "Set-Cookie", value: "grav-site-9f8e7d6=8ecf0f2233ae18fc3291616d46702e21; path=/cms; HttpOnly" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\" /><title>Login | Grav</title><meta name=\"generator\" content=\"GravCMS\" /><link href=\"/cms/user/plugins/login/css/login.css\" type=\"text/css\" rel=\"stylesheet\"></head><body><section id=\"grav-login\"><form method=\"post\" action=\"/cms/login\"><div data-grav-field=\"text\"><input name=\"username\" type=\"text\" /></div><input type=\"hidden\" name=\"task\" value=\"login.login\" /><input type=\"hidden\" name=\"login-form-nonce\" value=\"deadbeef\" /></form></section></body></html>"
      },
      {
        uri: "/cms/CHANGELOG.md"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/plain; charset=utf-8" }
        ]
        body: "# v1.7.53\n## 06/16/2026\n\n1. [](#bugfix)\n    * [security] Hardened `user/config` folder rules in Grav webserver configs\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: "/cms"
        expected_versions: ["1.7.53"]
      }
    ]
  },
