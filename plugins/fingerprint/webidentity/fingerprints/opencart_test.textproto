# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "opencart"

tests: [
  {
    name: "opencart_2_3_0_2_pending_install"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>License agreement</title>\n<base href=\"http://target.test:8080/install/\" />\n<link rel=\"stylesheet\" type=\"text/css\" href=\"view/stylesheet/stylesheet.css\" />\n</head>\n<body><div class=\"container\">\n<header><div id=\"logo\" class=\"pull-right hidden-xs\"><img src=\"view/image/logo.png\" alt=\"OpenCart\" title=\"OpenCart\" /></div></header>\n<h3>License agreement<br><small>Please read the OpenCart licence agreement</small></h3>\n<form action=\"http://target.test:8080/install/index.php?route=install/step_1\" method=\"post\" enctype=\"multipart/form-data\"></form>\n<footer><div class=\"container\"><a href=\"http://www.opencart.com\" target=\"_blank\">Project Homepage</a>|<a href=\"http://forum.opencart.com\" target=\"_blank\">Support Forums</a></div></footer>\n</div></body></html>"
      },
      {
        uri: "/install/index.php"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>License agreement</title>\n<base href=\"http://target.test:8080/install/\" />\n<link rel=\"stylesheet\" type=\"text/css\" href=\"view/stylesheet/stylesheet.css\" />\n</head>\n<body><div class=\"container\">\n<header><div id=\"logo\"><img src=\"view/image/logo.png\" alt=\"OpenCart\" title=\"OpenCart\" /></div></header>\n<small>Please read the OpenCart licence agreement</small>\n</div></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
  {
    name: "opencart_2_3_0_2_installed"
    mock_responses: [
