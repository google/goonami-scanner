  {
    name: "opencart_subpath_shop_via_catalog_common_js"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>Acme Corp</title></head><body><h1>Welcome to Acme Corp</h1></body></html>"
      },
      {
        uri: "/shop/catalog/view/javascript/common.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript" }
        ]
        body: "function getURLVar(key) {\n\tvar value = [];\n\tvar query = String(document.location).split('?');\n\treturn value[key] ? value[key] : '';\n}\n$(document).ready(function() {\n\t$('#form-currency .currency-select').on('click', function(e) {\n\t\te.preventDefault();\n\t\t$('#form-currency input[name=\\'code\\']').val($(this).attr('name'));\n\t\t$('#form-currency').submit();\n\t});\n});\nvar cart = {\n\t'add': function(product_id, quantity) {\n\t\t$.ajax({\n\t\t\turl: 'index.php?route=checkout/cart/add',\n\t\t\ttype: 'post'\n\t\t});\n\t}\n};\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: "/shop"
      }
    ]
  },
  {
    name: "opencart_4_1_subpath_store_via_admin_common_js"
    mock_responses: [
      {
        uri: "/store/admin/view/javascript/common.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/javascript" }
        ]
        body: "function getURLVar(key) {\n    var value = [];\n    return value[key] ? value[key] : '';\n}\n$(document).ready(function() {\n    $('#button-menu').on('click', function(e) {\n        $('#column-left').toggleClass('active');\n    });\n    if (!sessionStorage.getItem('menu')) {\n        $('#menu #menu-dashboard').addClass('active');\n    }\n    $.ajax({\n        url: 'index.php?route=common/language.save&user_token=' + getURLVar('user_token'),\n        type: 'post'\n    });\n});\n$(document).on('submit', 'form[data-oc-toggle=\\'ajax\\']', function(e) {});\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: "/store"
      }
    ]
  },
