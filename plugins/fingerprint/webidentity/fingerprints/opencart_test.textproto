      },
      {
        uri: "/admin/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html dir=\"ltr\" lang=\"en\">\n<head>\n<meta charset=\"UTF-8\" />\n<title>Administration</title>\n<base href=\"http://target.test:8080/admin/\" />\n<link type=\"text/css\" href=\"view/stylesheet/stylesheet.css\" rel=\"stylesheet\" media=\"screen\" />\n<script src=\"view/javascript/common.js\" type=\"text/javascript\"></script>\n</head>\n<body>\n<a href=\"http://target.test:8080/admin/index.php?route=common/dashboard\" class=\"navbar-brand\"><img src=\"view/image/logo.png\" alt=\"OpenCart\" title=\"OpenCart\" /></a>\n<form action=\"http://target.test:8080/admin/index.php?route=common/login\" method=\"post\" enctype=\"multipart/form-data\"></form>\n<footer id=\"footer\"><a href=\"http://www.opencart.com\">OpenCart</a> &copy; 2009-2026 All Rights Reserved.</footer>\n</body></html>"
      }
