  {
    name: "negative_blog_article_mentioning_opencart"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>OpenCart Security Guide</title><link href=\"/static/blog.css\" rel=\"stylesheet\"></head><body><h1>Hardening OpenCart Stores</h1><p>OpenCart loads catalog/view/javascript/common.js and routes requests via index.php?route=common/home with footer Powered By OpenCart (https://www.opencart.com).</p></body></html>"
      }
    ]
  }
]
