# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "hadoop_yarn"

tests: [
  {
    name: "yarn_3_5_0_default_resourcemanager_ui_and_rest_api"
    mock_responses: [
      {
        uri: "/"
        status_code: 302
        headers: [
          { name: "Content-Type", value: "text/plain;charset=utf-8" },
          { name: "Location", value: "http://target.test:8080/cluster" },
          { name: "X-Frame-Options", value: "SAMEORIGIN" }
        ]
        body: ""
      },
      {
        uri: "/cluster"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=utf-8" }
        ]
        body: "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html>\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=8\">\n  <meta http-equiv=\"Content-type\" content=\"text/html; charset=UTF-8\">\n  <title>\n    About the Cluster\n  </title>\n  <link rel=\"stylesheet\" href=\"/static/yarn.css\">\n  <script type=\"text/javascript\" src=\"/static/yarn.dt.plugins.js\">\n  </script>\n  <table><tbody><tr><td id=\"navcell\"><div id=\"nav\"><h3>Cluster</h3><ul><li><a href=\"/cluster/cluster\">About</a></li><li><a href=\"/cluster/apps\">Applications</a></li></ul></div></td><td class=\"content\"><div><table id=\"metricsoverview\"><caption>Cluster Metrics</caption></table><table><tr class=\"odd\"><th>ResourceManager state:</th><td>STARTED</td></tr><tr class=\"odd\"><th>ResourceManager version:</th><td>\n                  3.5.0 from dbcc7cd797100e6b32cd84f85b53a5193a5f9af0 by cnauroth source checksum 5f245a9fee3873666f512583c5df5d7 on 2026-03-24T17:01Z\n                </td></tr><tr class=\"even\"><th>Hadoop version:</th><td>\n                  3.5.0 from dbcc7cd797100e6b32cd84f85b53a5193a5f9af0 by cnauroth source checksum 64582ed0a62a169c39a19c734a8f33b5 on 2026-03-24T16:56Z\n                </td></tr></table></div></td></tr></tbody></table>\n</html>\n"
      },
      {
        uri: "/ws/v1/cluster/info"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json;charset=utf-8" },
          { name: "X-Content-Type-Options", value: "nosniff" }
        ]
        body: "{\"clusterInfo\":{\"id\":1793793933624,\"startedOn\":1793793933624,\"state\":\"STARTED\",\"haState\":\"ACTIVE\",\"rmStateStoreName\":\"org.apache.hadoop.yarn.server.resourcemanager.recovery.NullRMStateStore\",\"resourceManagerVersion\":\"3.5.0\",\"resourceManagerBuildVersion\":\"3.5.0 from dbcc7cd797100e6b32cd84f85b53a5193a5f9af0 by cnauroth source checksum 5f245a9fee3873666f512583c5df5d7\",\"resourceManagerVersionBuiltOn\":\"2026-03-24T17:01Z\",\"hadoopVersion\":\"3.5.0\",\"hadoopBuildVersion\":\"3.5.0 from dbcc7cd797100e6b32cd84f85b53a5193a5f9af0 by cnauroth source checksum 64582ed0a62a169c39a19c734a8f33b5\",\"hadoopVersionBuiltOn\":\"2026-03-24T16:56Z\",\"haZooKeeperConnectionState\":\"Could not find leader elector. Verify both HA and automatic failover are enabled.\"}}"
      },
      {
        uri: "/static/yarn.css"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/css" }
        ]
        body: "/* Styles for YARN */\n* { margin: 0; border: 0 }\n#themeswitcher { margin: 1em 0.25em }\n"
      },
      {
        uri: "/static/yarn.dt.plugins.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript" }
        ]
        body: "if (!jQuery.fn.dataTableExt.fnVersionCheck(\"1.7.5\")) { alert(\"These plugins requires dataTables 1.7.5+\"); }\nfunction parseHadoopID(data, type, full) { return data; }\nfunction parseHadoopProgress(data, type, full) { return data; }\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.5.0"]
      }
    ]
  },
