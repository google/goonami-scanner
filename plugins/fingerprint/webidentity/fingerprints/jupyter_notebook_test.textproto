# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "jupyter_notebook"

tests: [
  {
    name: "notebook_5_7_16_authenticated_login_identification"
    mock_responses: [
      {
        uri: "/"
        status_code: 302
        headers: [
          { name: "Content-Type" value: "text/html; charset=UTF-8" },
          { name: "Location" value: "/tree?" },
          { name: "Server" value: "TornadoServer/6.1" }
        ]
        body: ""
      },
      {
        uri: "/login"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html; charset=UTF-8" },
          { name: "Server" value: "TornadoServer/6.1" }
        ]
        body: "<!DOCTYPE HTML>\n<html>\n<head>\n    <meta charset=\"utf-8\">\n    <title>Jupyter Notebook</title>\n    <link id=\"favicon\" rel=\"shortcut icon\" type=\"image/x-icon\" href=\"/static/base/images/favicon.ico?v=50afa725\">\n    <link rel=\"stylesheet\" href=\"/static/style/style.min.css?v=e652140d\" type=\"text/css\"/>\n    <link rel=\"stylesheet\" href=\"/static/auth/css/override.css?v=ffd040ea\" type=\"text/css\" />\n</head>\n<body class=\"\" dir=\"ltr\">\n<div id=\"header\">\n  <div id=\"header-container\" class=\"container\">\n    <div id=\"ipython_notebook\" class=\"nav navbar-brand\"><a href=\"/tree\" title='dashboard'>\n      <img src='/static/base/images/logo.png?v=a2a176ee' alt='Jupyter Notebook'/>\n    </a></div>\n  </div>\n</div>\n<div id=\"site\">\n  <div id=\"ipython-main-app\" class=\"container\">\n    <form action=\"/login?next=%2F\" method=\"post\" class=\"navbar-form pull-left\">\n      <label for=\"password_input\"><strong>Password or token:</strong></label>\n      <input type=\"password\" name=\"password\" id=\"password_input\" class=\"form-control\">\n      <button type=\"submit\" class=\"btn btn-default\" id=\"login_submit\">Log in</button>\n    </form>\n  </div>\n</div>\n<script type=\"text/javascript\">\n  require([\"auth/js/main\"], function (auth) { auth.login_main(); });\n</script>\n</body>\n</html>"
      },
      {
        uri: "/api"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json" },
          { name: "Server" value: "TornadoServer/6.1" }
        ]
        body: "{\"version\": \"5.7.16\"}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["5.7.16"]
      }
    ]
  },
