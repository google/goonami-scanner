        ]
        body: "!function(e,n){exports.centraldashboard=n()}(window,(function(){return{buildVersion:{type:String,value:\"dev_local\"},dashVersion:{type:String,value:\"0.0.2-\"},endpoints:[\"api/workgroup/env-info\",\"api/workgroup/exists\",\"api/dashboard-links\"],handler:\"CentralDashboardEventHandler\",platform:\"kubeflowVersion\"}}));"
      },
      {
        uri: "/api/workgroup/env-info"
        status_code: 400
        headers: [
          { name: "Content-Type" value: "application/json; charset=utf-8" }
        ]
        body: "{\"error\":\"Unexpected error getting environment info\"}"
      },
      {
        uri: "/api/workgroup/exists"
        status_code: 400
        headers: [
          { name: "Content-Type" value: "application/json; charset=utf-8" }
        ]
        body: "{\"error\":\"Unable to contact Profile Controller\"}"
      },
      {
        uri: "/api/dashboard-links"
        status_code: 500
        headers: [
          { name: "Content-Type" value: "application/json; charset=utf-8" }
        ]
        body: "{\"error\":\"Cannot load dashboard menu link\"}"
      },
      {
        uri: "/debug"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json; charset=utf-8" }
        ]
        body: "{\"user\":{\"email\":\"anonymous@kubeflow.org\",\"username\":\"anonymous\",\"domain\":\"kubeflow.org\",\"hasAuth\":false},\"profilesServiceUrl\":\"http://profiles-kfam.kubeflow:8081/kfam\",\"codeEnvironment\":\"production\",\"registrationFlowAllowed\":true,\"headersForIdentity\":{\"USERID_HEADER\":\"X-Goog-Authenticated-User-Email\",\"USERID_PREFIX\":\"accounts.google.com:\"}}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
