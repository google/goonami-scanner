# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "kubeflow"

tests: [
  {
    name: "kubeflow_v1_6_0_configured_anonymous"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "X-Powered-By" value: "Express" },
          { name: "Content-Type" value: "text/html; charset=UTF-8" }
        ]
        body: "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"><meta name=\"viewport\" content=\"width=device-width,minimum-scale=1,initial-scale=1,user-scalable=yes\"><meta name=\"description\" content=\"Kubeflow Central Dashboard\"><meta name=\"theme-color\" content=\"#3f51b5\"><title>Kubeflow Central Dashboard</title><link rel=\"shortcut icon\" href=\"/assets/favicon.ico\"><link rel=\"icon\" href=\"/assets/favicon-32x32.png\" sizes=\"32x32\"><base href=\"/\"><script src=\"webcomponentsjs/webcomponents-loader.js\"></script><script src=\"webcomponentsjs/custom-elements-es5-adapter.js\"></script><link href=\"app.css\" rel=\"stylesheet\"></head><body><main-page></main-page><noscript>Please enable JavaScript to view this website.</noscript><script src=\"vendor.bundle.js\" defer=\"defer\"></script><script src=\"app.bundle.js\" defer=\"defer\"></script><script src=\"dashboard_lib.bundle.js\" defer=\"defer\"></script></body></html>"
      },
      {
        uri: "/app.bundle.js"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/javascript; charset=UTF-8" }
        ]
        body: "!function(e,n){\"object\"==typeof exports?exports.centraldashboard=n():e.centraldashboard=n()}(window,(function(){return{buildVersion:{type:String,value:\"dev_local\"},dashVersion:{type:String,value:\"0.0.2-39bd19\"},endpoints:[\"api/workgroup/env-info\",\"api/workgroup/exists\",\"api/dashboard-links\"],handler:\"CentralDashboardEventHandler\",platform:\"kubeflowVersion\",docs:\"https://www.kubeflow.org/\"}}));"
      },
      {
        uri: "/api/workgroup/env-info"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json; charset=utf-8" }
        ]
        body: "{\"user\":\"anonymous@kubeflow.org\",\"platform\":{\"kubeflowVersion\":\"v1.6.0\",\"provider\":\"gce://kf-proj/us-central1-a/node-1\",\"providerName\":\"gce\"},\"namespaces\":[{\"namespace\":\"kubeflow-user-example-com\",\"role\":\"contributor\",\"user\":\"anonymous@kubeflow.org\"}],\"isClusterAdmin\":true}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["1.6.0"]
      }
    ]
  },
  {
    name: "kubeflow_v1_7_0_unconfigured_no_cluster"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "X-Powered-By" value: "Express" },
          { name: "Content-Type" value: "text/html; charset=UTF-8" }
        ]
        body: "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"description\" content=\"Kubeflow Central Dashboard\"><meta name=\"theme-color\" content=\"#3f51b5\"><title>Kubeflow Central Dashboard</title><link rel=\"shortcut icon\" href=\"/assets/favicon.ico\"><base href=\"/\"><link href=\"app.css\" rel=\"stylesheet\"></head><body><main-page></main-page><script src=\"vendor.bundle.js\" defer=\"defer\"></script><script src=\"app.bundle.js\" defer=\"defer\"></script><script src=\"dashboard_lib.bundle.js\" defer=\"defer\"></script></body></html>"
