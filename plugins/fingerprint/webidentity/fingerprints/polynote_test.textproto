# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "polynote"

tests: [
  {
    name: "polynote_v0_3_2_legacy_root_and_index_identification"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <title>Polynote</title>\n    <meta charset=\"utf-8\" />\n    <base href=\"/\" />\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"style/styles.css\" />\n    <link rel=\"stylesheet\" href=\"vendor/katex/katex.min.css\">\n    <script defer src=\"vendor/katex/katex.min.js\"></script>\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\n  </head>\n  <body>\n    <div id=\"Main\" data-ws-key=\"733ab277-ee15-4db5-aa77-f129e717c585\" />\n  <script type=\"text/javascript\" src=\"app.7b3fefbb5c1bd4a372e8.js\"></script></body>\n</html>\n"
      },
      {
        uri: "/app.7b3fefbb5c1bd4a372e8.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript" }
        ]
        body: "!function(e){document.title=\"Polynote\";var el=document.getElementById(\"Main\"),k=el.getAttribute(\"data-ws-key\"),logo=\"style/polynote.svg\";}([]);"
      },
      {
        uri: "/index.html"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <title>Polynote</title>\n    <meta charset=\"utf-8\" />\n    <base href=\"$BASE_URI\" />\n    <link rel=\"stylesheet\" type=\"text/css\" href=\"style/styles.css\" />\n    <link rel=\"stylesheet\" href=\"vendor/katex/katex.min.css\">\n    <script defer src=\"vendor/katex/katex.min.js\"></script>\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\n  </head>\n  <body>\n    <div id=\"Main\" data-ws-key=\"$WS_KEY\" />\n  <script type=\"text/javascript\" src=\"app.7b3fefbb5c1bd4a372e8.js\"></script></body>\n</html>\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["0.3.2"]
      }
    ]
  },
