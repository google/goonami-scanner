# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "prometheus"

tests: [
  {
    name: "prometheus_v2_19_3_classic_ui_and_buildinfo_api"
    mock_responses: [
      {
        uri: "/"
        status_code: 302
        headers: [
          { name: "Content-Type" value: "text/html; charset=utf-8" },
          { name: "Location" value: "/graph" }
        ]
        body: "<a href=\"/graph\">Found</a>.\n\n"
      },
      {
        uri: "/graph"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n        <meta name=\"robots\" content=\"noindex,nofollow\">\n        <title>Prometheus Time Series Collection and Processing Server</title>\n        <link rel=\"shortcut icon\" href=\"/static/img/favicon.ico?v=657ba532e42f1db8d7c77bf802378643da0d3118\">\n        <link type=\"text/css\" rel=\"stylesheet\" href=\"/static/css/prometheus.css?v=657ba532e42f1db8d7c77bf802378643da0d3118\">\n        <link type=\"text/css\" rel=\"stylesheet\" href=\"/static/css/graph.css?v=657ba532e42f1db8d7c77bf802378643da0d3118\">\n        <script>\n            var PATH_PREFIX = \"\";\n            var BUILD_VERSION = \"657ba532e42f1db8d7c77bf802378643da0d3118\";\n        </script>\n    </head>\n    <body>\n    </body>\n</html>"
      },
      {
        uri: "/api/v1/status/buildinfo"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json" }
        ]
        body: "{\"status\":\"success\",\"data\":{\"version\":\"2.19.3\",\"revision\":\"657ba532e42f1db8d7c77bf802378643da0d3118\",\"branch\":\"HEAD\",\"buildUser\":\"root@32727b944462\",\"buildDate\":\"20200707-17:04:01\",\"goVersion\":\"go1.14.4\"}}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.19.3"]
      }
    ]
  },
  {
    name: "prometheus_v2_19_3_classic_status_page_version_extraction"
    mock_responses: [
      {
        uri: "/status"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n    <head>\n        <meta http-equiv=\"Content-Type\" content=\"text/html; charset=utf-8\">\n        <title>Prometheus Time Series Collection and Processing Server</title>\n        <link type=\"text/css\" rel=\"stylesheet\" href=\"/static/css/prometheus.css?v=657ba532e42f1db8d7c77bf802378643da0d3118\">\n        <script>\n            var PATH_PREFIX = \"\";\n            var BUILD_VERSION = \"657ba532e42f1db8d7c77bf802378643da0d3118\";\n        </script>\n    </head>\n    <body>\n        <div class=\"container-fluid\">\n            <h2>Build Information</h2>\n            <table class=\"table table-condensed table-bordered table-striped table-hover\">\n                <tbody>\n                    <tr>\n                        <th>Version</th>\n                        <td>2.19.3</td>\n                    </tr>\n                    <tr>\n                        <th>Revision</th>\n                        <td>657ba532e42f1db8d7c77bf802378643da0d3118</td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n    </body>\n</html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.19.3"]
      }
    ]
  },
  {
