# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "joomla"

tests: [
  {
    name: "joomla_3_10_12_pending_install"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en-gb\" dir=\"ltr\">\n<head>\n\t<meta charset=\"utf-8\" />\n\t<meta name=\"generator\" content=\"Joomla! - Open Source Content Management\" />\n\t<title>Joomla! Web Installer</title>\n\t<link href=\"/installation/favicon.ico\" rel=\"shortcut icon\" type=\"image/vnd.microsoft.icon\" />\n\t<link href=\"/media/jui/css/bootstrap.min.css?bb45e864e75a7df4223966240a68a356\" rel=\"stylesheet\" />\n\t<link href=\"/installation/template/css/template.css?bb45e864e75a7df4223966240a68a356\" rel=\"stylesheet\" />\n\t<script type=\"application/json\" class=\"joomla-script-options new\">{\"csrf.token\":\"8a3af04f275932dc14b2d4e041d3eda0\",\"system.paths\":{\"root\":\"\",\"base\":\"\\/installation\"}}</script>\n</head>\n<body><a href=\"#\" onclick=\"Install.submitform();\">Next</a></body>\n</html>"
      },
      {
        uri: "/installation/index.php"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en-gb\" dir=\"ltr\">\n<head>\n\t<meta charset=\"utf-8\" />\n\t<meta name=\"generator\" content=\"Joomla! - Open Source Content Management\" />\n\t<title>Joomla! Web Installer</title>\n\t<link href=\"/media/jui/css/bootstrap.min.css?bb45e864e75a7df4223966240a68a356\" rel=\"stylesheet\" />\n\t<link href=\"/installation/template/css/template.css?bb45e864e75a7df4223966240a68a356\" rel=\"stylesheet\" />\n</head>\n<body><a href=\"#\" onclick=\"Install.submitform();\">Next</a></body>\n</html>"
      },
      {
        uri: "/administrator/manifests/files/joomla.xml"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/xml" }
        ]
        body: "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<extension version=\"3.6\" type=\"file\" method=\"upgrade\">\n\t<name>files_joomla</name>\n\t<author>Joomla! Project</author>\n\t<authorEmail>admin@joomla.org</authorEmail>\n\t<authorUrl>www.joomla.org</authorUrl>\n\t<copyright>(C) 2019 Open Source Matters, Inc.</copyright>\n\t<license>GNU General Public License version 2 or later; see LICENSE.txt</license>\n\t<version>3.10.12</version>\n\t<creationDate>July 2023</creationDate>\n\t<description>FILES_JOOMLA_XML_DESCRIPTION</description>\n</extension>\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.10.12"]
      }
    ]
  },
  {
    name: "joomla_3_10_12_installed_admin_restricted_en_gb_xml"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en-gb\" dir=\"ltr\">\n<head>\n\t<meta charset=\"utf-8\" />\n\t<meta name=\"generator\" content=\"Joomla! - Open Source Content Management\" />\n\t<title>Home</title>\n\t<link href=\"/templates/protostar/favicon.ico\" rel=\"shortcut icon\" type=\"image/vnd.microsoft.icon\" />\n\t<link href=\"/templates/protostar/css/template.css?2395b4efcb1c586732c398fe0542aab8\" rel=\"stylesheet\" />\n\t<script src=\"/media/jui/js/jquery.min.js?2395b4efcb1c586732c398fe0542aab8\"></script>\n\t<script src=\"/media/system/js/caption.js?2395b4efcb1c586732c398fe0542aab8\"></script>\n</head>\n<body><p>&copy; 2026 Joomla!</p></body>\n</html>"
      },
      {
        uri: "/administrator/manifests/files/joomla.xml"
        status_code: 403
        headers: [
          { name: "Content-Type", value: "text/html; charset=iso-8859-1" }
        ]
        body: "<html><body>403 Forbidden</body></html>"
      },
      {
        uri: "/language/en-GB/en-GB.xml"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/xml" }
        ]
        body: "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<metafile version=\"3.9\" client=\"site\">\n\t<name>English (en-GB)</name>\n\t<version>3.10.12</version>\n\t<creationDate>July 2023</creationDate>\n\t<author>Joomla! Project</author>\n\t<authorEmail>admin@joomla.org</authorEmail>\n\t<copyright>(C) 2006 Open Source Matters, Inc.</copyright>\n</metafile>\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.10.12"]
      }
    ]
  },
  {
