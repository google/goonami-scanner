      },
      {
        uri: "/search/opensearch.xml"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/xml; charset=utf-8" }
        ]
        body: "<OpenSearchDescription xmlns=\"http://a9.com/-/spec/opensearch/1.1/\"><ShortName>GitLab</ShortName><Description>Search GitLab</Description><Url type=\"text/html\" method=\"get\" template=\"http://target.test:8080/search?search={searchTerms}\"/></OpenSearchDescription>"
      }
    ]
