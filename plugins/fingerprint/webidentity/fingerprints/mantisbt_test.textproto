  {
    name: "mantisbt_swagger_and_wsdl_when_database_offline"
    mock_responses: [
      {
        uri: "/"
        status_code: 500
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>MantisBT</title></head><body><p>APPLICATION ERROR #400: Database connection failed.</p></body></html>"
      },
      {
        uri: "/api/rest/swagger.json"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json" }
        ]
        body: "{\n  \"swagger\": \"2.0\",\n  \"info\": {\n    \"version\": \"1.0.0\",\n    \"title\": \"MantisBT REST API\"\n  },\n  \"basePath\": \"/api/rest\"\n}\n"
      },
      {
        uri: "/api/soap/mantisconnect.wsdl"
        status_code: 200
        headers: [
