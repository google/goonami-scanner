    ]
  },
  {
    name: "negative_blog_article_mentioning_mantisbt"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>Bug Tracker Review - MantisBT</title></head><body><h1>Comparing Jira and MantisBT 2.28.4</h1><p>Visit <a href=\"https://www.mantisbt.org\">MantisBT</a> for more details.</p></body></html>"
      }
    ]
  }
]
