        body: "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>\n<definitions targetNamespace=\"http://futureware.biz/mantisconnect\">\n<service name=\"MantisConnect\"></service>\n</definitions>\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
