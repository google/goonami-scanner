# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "locust"

tests: [
  {
    name: "locust_2_47_0_modern_ui_idle_ready"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-light.png\" media=\"(prefers-color-scheme: light)\">\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-dark.png\" media=\"(prefers-color-scheme: dark)\">\n    <title>Locust</title>\n    <script type=\"module\" crossorigin src=\"./assets/src-Cl6CiemE.js\"></script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script>\n      window.templateArgs = {\"available_shape_classes\": [\"Default\"], \"available_user_classes\": [\"ApiUser\", \"WebsiteUser\"], \"host\": \"http://127.0.0.1:8089\", \"is_distributed\": false, \"locustfile\": \"locustfile.py\", \"percentiles_to_chart\": [0.5, 0.95], \"show_userclass_picker\": true, \"state\": \"ready\", \"user_count\": 0, \"version\": \"2.47.0\", \"worker_count\": 0}\n    </script>\n  </body>\n</html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.47.0"]
      }
    ]
  },
  {
    name: "locust_2_47_0_modern_ui_running_swarm"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-light.png\">\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-dark.png\">\n    <title>Locust</title>\n    <script type=\"module\" crossorigin src=\"./assets/src-Cl6CiemE.js\"></script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script>\n      window.templateArgs = {\"history\": [{\"current_rps\": [\"2026-11-04T14:29:28Z\", 1.25], \"user_count\": [\"2026-11-04T14:29:28Z\", 2]}], \"host\": \"http://127.0.0.1:8089\", \"locustfile\": \"locustfile.py\", \"num_users\": 2, \"percentiles_to_chart\": [0.5, 0.95], \"spawn_rate\": 2.0, \"state\": \"running\", \"user_count\": 2, \"version\": \"2.47.0\", \"worker_count\": 0}\n    </script>\n  </body>\n</html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.47.0"]
      }
    ]
  },
  {
    name: "locust_2_47_0_web_login_default_title"
    mock_responses: [
      {
        uri: "/"
        status_code: 302
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" },
          { name: "Location", value: "/login?next=%2F" }
        ]
        body: "<!doctype html><html lang=en><title>Redirecting...</title><h1>Redirecting...</h1>"
      },
      {
        uri: "/login"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-light.png\" media=\"(prefers-color-scheme: light)\">\n    <link rel=\"shortcut icon\" href=\"./assets/favicon-dark.png\" media=\"(prefers-color-scheme: dark)\">\n    <title>Locust</title>\n    <script type=\"module\" crossorigin src=\"./assets/src-Cl6CiemE.js\"></script>\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script>\n        window.authArgs = {\"error\": null, \"info\": null, \"username_password_callback\": \"/login_submit\"}\n    </script>\n  </body>\n</html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
  {
    name: "locust_2_47_0_web_login_custom_title_verified_via_bundle"
    mock_responses: [
      {
        uri: "/login"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\"><head><title>Perf Portal Sign In</title><script type=\"module\" crossorigin src=\"./assets/src-Cl6CiemE.js\"></script></head><body><div id=\"root\"></div><script>window.authArgs = {\"error\": null, \"info\": null, \"username_password_callback\": \"/login_submit\"}</script></body></html>"
      },
      {
        uri: "/assets/src-Cl6CiemE.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript; charset=utf-8" }
        ]
        body: "const vi=!!window.authArgs&&pi(window.authArgs);const licenseUrl=`https://github.com/locustio/locust/blob/master/LICENSE`;const msg=`Locust is free and open source software`;"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
