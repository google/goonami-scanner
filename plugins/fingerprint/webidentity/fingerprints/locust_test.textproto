  {
    name: "locust_1_6_0_basic_auth_unauthenticated_static_js"
    mock_responses: [
      {
        uri: "/"
        status_code: 401
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" },
          { name: "WWW-Authenticate", value: "Basic realm=\"\"" }
        ]
        body: ""
      },
      {
        uri: "/stats/requests"
        status_code: 401
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" },
          { name: "WWW-Authenticate", value: "Basic realm=\"\"" }
        ]
        body: ""
      },
      {
        uri: "/static/locust.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript; charset=utf-8" }
        ]
        body: "var rpsChart = new LocustLineChart($(\".charts-container\"), \"Total Requests per Second\");\nvar responseTimeChart = new LocustLineChart($(\".charts-container\"), \"Response Times (ms)\");\n$.get('./stats/requests', function (report) {});\n$('#exceptions tbody').jqoteapp(exceptions_tpl, data.exceptions);"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
