# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "ray"

tests: [
  {
    name: "ray_1_13_1_idle_cluster_ui_and_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html" },
          { name: "Server", value: "Python/3.7 aiohttp/3.8.1" }
        ]
        body: "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"/><link rel=\"shortcut icon\" href=\"./favicon.ico\"/><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"/><title>Ray Dashboard</title><link href=\"./static/css/2.65aa3b33.chunk.css\" rel=\"stylesheet\"><link href=\"./static/css/main.209b3f5e.chunk.css\" rel=\"stylesheet\"></head><body><noscript>You need to enable JavaScript to run this app.</noscript><div id=\"root\"></div><script src=\"./static/js/2.c7ecb373.chunk.js\"></script><script src=\"./static/js/main.96d021bc.chunk.js\"></script></body></html>"
      },
      {
        uri: "/static/js/main.96d021bc.chunk.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/javascript" }
        ]
        body: "var title=\"Ray Dashboard\";var summaryUrl=\"nodes?view=summary\";var cfgUrl=\"api/ray_config\";var docs=\"https://docs.ray.io\";var app=\"ray-dashboard\";"
      },
      {
        uri: "/api/version"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json; charset=utf-8" }
        ]
        body: "{\"version\": \"1\", \"ray_version\": \"1.13.1\", \"ray_commit\": \"da2a91cd34ac58df4c49b2fa65a5bd25bc1e2057\"}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["1.13.1"]
      }
    ]
  },
  {
