      },
      {
        uri: "/api/cluster_status"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json; charset=utf-8" }
        ]
        body: "{\"result\": true, \"msg\": \"Got cluster status.\", \"data\": {\"autoscalingStatus\": \"Cluster status: 0 nodes\", \"autoscalingError\": null, \"clusterStatus\": {\"loadMetricsReport\": {\"usage\": {\"CPU\": [0.0, 48.0]}}}}}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.43.0"]
      }
    ]
  },
