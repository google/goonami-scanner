# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "magento"

tests: [
  {
    name: "magento_2_4_8_configured_pub_webroot"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" },
          { name: "X-Magento-Cache-Debug", value: "MISS" }
        ]
        body: "<!doctype html>\n<html lang=\"en\">\n<head>\n<script>\n    var BASE_URL = 'http\\u003A\\u002F\\u002Ftarget.test\\u003A8080\\u002F';\n    var require = {'baseUrl': 'http\\u003A\\u002F\\u002Ftarget.test\\u003A8080\\u002Fstatic\\u002Fversion1793804278\\u002Ffrontend\\u002FMagento\\u002Fluma\\u002Fen_US'};\n</script>\n<link rel=\"stylesheet\" type=\"text/css\" media=\"all\" href=\"http://target.test:8080/static/version1793804278/frontend/Magento/luma/en_US/mage/calendar.css\" />\n<script type=\"text/javascript\" src=\"http://target.test:8080/static/version1793804278/frontend/Magento/luma/en_US/requirejs/require.js\"></script>\n<script type=\"text/javascript\" src=\"http://target.test:8080/static/version1793804278/frontend/Magento/luma/en_US/mage/requirejs/mixins.js\"></script>\n<script type=\"text/javascript\" src=\"http://target.test:8080/static/version1793804278/frontend/Magento/luma/en_US/requirejs-config.js\"></script>\n<title>Home Page</title>\n</head>\n<body data-container=\"body\" data-mage-init='{\"loaderAjax\": {}, \"loader\": { \"icon\": \"http://target.test:8080/static/version1793804278/frontend/Magento/luma/en_US/images/loader-2.gif\"}}' class=\"cms-home cms-index-index page-layout-1column\">\n<script type=\"text/x-magento-init\">\n{\"*\": {\"Magento_Ui/js/core/app\": {\"components\": {}}}}\n</script>\n</body>\n</html>"
      },
      {
        uri: "/magento_version"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" },
          { name: "X-Magento-Cache-Debug", value: "MISS" }
        ]
        body: "Magento/2.4 (Community)"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.4"]
      }
    ]
  },
  {
    name: "magento_2_4_8_configured_root_webroot_exact_setup_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "<!doctype html><html lang=\"en\"><head><script src=\"http://target.test:8080/pub/static/version1793804278/frontend/Magento/luma/en_US/requirejs-config.js\"></script></head><body data-mage-init='{}'><script type=\"text/x-magento-init\">{\"*\": {\"Magento_Ui/js/core/app\": {}}}</script></body></html>"
      },
      {
        uri: "/setup/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "<!--[if !IE]><!-->\n<html lang=\"en\">\n<!--<![endif]-->\n<head>\n    <meta charset=\"utf-8\">\n    <title>Magento</title>\n    <link href=\"/setup/pub/styles/setup.css\" media=\"screen\" rel=\"stylesheet\" type=\"text/css\" />\n    <script src=\"/setup/pub/scripts/main.js\"></script>\n</head>\n<body>\n<div class=\"container\">\n    <main class=\"page-content\">\n        <section data-section=\"landing\" class=\"page-landing\">\n            <img class=\"logo\" src=\"/setup/pub/images/magento-logo.svg\" alt=\"Magento\"/>\n            <p class=\"text-version\">Version 2.4.8</p>\n            <p class=\"text-welcome\">Welcome to Magento Admin, your online store headquarters.</p>\n        </section>\n    </main>\n</div>\n</body>\n</html>"
      },
      {
        uri: "/magento_version"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "Magento/2.4 (Community)"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.4.8"]
      }
    ]
  },
  {
    name: "magento_2_4_7_p4_unconfigured_root_webroot_setup_landing"
    mock_responses: [
