        body: "<html lang=\"en\"><head><title>Magento</title><link href=\"/setup/pub/styles/setup.css\" media=\"screen\" rel=\"stylesheet\" type=\"text/css\" /><script src=\"/setup/pub/scripts/main.js\"></script></head><body><section data-section=\"landing\" class=\"page-landing\"><img class=\"logo\" src=\"/setup/pub/images/magento-logo.svg\" alt=\"Magento\"/><p class=\"text-version\">Version 2.4.7-p4</p><p class=\"text-welcome\">Welcome to Magento Admin, your online store headquarters.</p></section></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.4.7-p4"]
      }
    ]
  },
