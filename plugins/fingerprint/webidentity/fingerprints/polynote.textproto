workflows: [
  # Active root HTML + extracted webpack JS bundle verification & version extraction.
  {
    steps: [
      "polynote_root_page",
      "polynote_js_bundle_active"
    ]
  },
  # Active root HTML + 0.3.4+ /static/index.html static template version extraction.
  {
    steps: [
      "polynote_root_shell",
      "polynote_static_index_html"
    ]
  },
  # Active root HTML + 0.2.11-0.3.3 /index.html static template version extraction.
  {
    steps: [
      "polynote_root_shell",
      "polynote_legacy_index_html"
    ]
  },
  # Passive subpath discovery and bundle identification via crawled Polynote JS bundle.
  {
    steps: ["polynote_js_bundle_passive"]
  },
  # Passive subpath discovery and static template identification via /static/index.html (0.3.4+).
  {
    steps: ["polynote_static_index_html"]
  },
  # Passive subpath discovery and static template identification via /index.html (0.2.11-0.3.3).
  {
    steps: ["polynote_legacy_index_html"]
  },
  # Passive subpath discovery and stylesheet identification via /style/styles.css or /static/style/styles.css + favicon corroboration.
  {
    steps: [
      "polynote_styles_css",
      "polynote_favicon_ico"
    ]
  },
  # Standalone Polynote stylesheet identification when favicon is not served.
  {
    steps: ["polynote_styles_css"]
  },
  # Fallback root shell + 0.3.4+ SVG logo verification when bundle naming changes.
  {
    steps: [
      "polynote_root_shell",
      "polynote_logo_svg"
    ]
  },
  # Fallback root shell + 0.2.11-0.3.3 SVG logo verification when bundle naming changes.
  {
    steps: [
      "polynote_root_shell",
      "polynote_legacy_logo_svg"
    ]
  }
]
