# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprint

info: {
  name: "Craft CMS"
  author: "Goonami team"
  software: "craftcms"
  description: "Detects Craft CMS content management system across installed and pending-install states and extracts version."
}

steps: [
  # Control Panel login page (HTTP 200 when installed, HTTP 503 when pending install or offline)
  # that extracts the published /cpresources/<hex>/cp.js asset path for version identification.
  {
    name: "craftcms_admin_login_extract_cp_js"
    path_suffix: "/admin/login"
    response: {
      status_codes: [200, 503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.LoginForm"
          },
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            regexp: "Craft isn(?:'|’)t installed yet"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
      extract_all: {
        patterns: [
          {
            variable_name: "cp_js_path"
            from_body: {}
            regexp: "[\"'][^\"']*?(cpresources/[0-9a-f]+/cp\\.js(?:\\?v=[0-9]+)?)[\"']"
          }
        ]
      }
    }
  },
  # Pending-install or system-offline HTTP 503 root page that embeds window.Craft and cp.js.
  {
    name: "craftcms_offline_root_extract_cp_js"
    path: "/"
    response: {
      status_codes: [503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
      extract_all: {
        patterns: [
          {
            variable_name: "cp_js_path"
            from_body: {}
            regexp: "[\"'][^\"']*?(cpresources/[0-9a-f]+/cp\\.js(?:\\?v=[0-9]+)?)[\"']"
          }
        ]
      }
    }
  },
  # Control Panel web installer wizard (/admin/install returns HTTP 200 when pending installation)
  # that extracts the published /cpresources/<hex>/cp.js asset path.
  {
    name: "craftcms_admin_install_extract_cp_js"
    path_suffix: "/admin/install"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:install|cp)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.Installer"
          },
          {
            body: {}
            contains: "<title>Install Craft CMS"
          },
          {
            body: {}
            contains: "begininstall"
          }
        ]
      }
      extract_all: {
        patterns: [
          {
            variable_name: "cp_js_path"
            from_body: {}
            regexp: "[\"'][^\"']*?(cpresources/[0-9a-f]+/cp\\.js(?:\\?v=[0-9]+)?)[\"']"
          }
        ]
      }
    }
  },
  # Non-rewrite query-parameter Control Panel login route (/index.php?p=admin/login)
  # that extracts cp.js for version identification.
  {
    name: "craftcms_index_php_admin_login_extract_cp_js"
    path: "/index.php?p=admin/login"
    response: {
      status_codes: [200, 503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.LoginForm"
          },
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            regexp: "Craft isn(?:'|’)t installed yet"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
      extract_all: {
        patterns: [
          {
            variable_name: "cp_js_path"
            from_body: {}
            regexp: "[\"'][^\"']*?(cpresources/[0-9a-f]+/cp\\.js(?:\\?v=[0-9]+)?)[\"']"
          }
        ]
      }
    }
  },
  # Non-rewrite query-parameter Control Panel installer route (/index.php?p=admin/install)
  # that extracts cp.js for version identification.
  {
    name: "craftcms_index_php_admin_install_extract_cp_js"
    path: "/index.php?p=admin/install"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
