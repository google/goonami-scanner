          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:install|cp)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.Installer"
          },
          {
            body: {}
            contains: "<title>Install Craft CMS"
          },
          {
            body: {}
            contains: "begininstall"
          }
        ]
      }
      extract_all: {
        patterns: [
          {
            variable_name: "cp_js_path"
            from_body: {}
            regexp: "[\"'][^\"']*?(cpresources/[0-9a-f]+/cp\\.js(?:\\?v=[0-9]+)?)[\"']"
          }
        ]
      }
    }
  },
  # Published Control Panel core JS bundle (/cpresources/<hex>/cp.js) verified via Craft/Garnish
  # class definitions and mapped to exact Craft CMS versions via SHA-256 and Murmur3-128 hashes.
  {
    name: "craftcms_cp_js_version"
    path: "/{{ cp_js_path }}"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "Garnish\\.(?:Base|Modal)"
          },
          {
            body: {}
            regexp: "Craft\\.(?:Accordion|Uploader|ElementIndex|LoginForm)"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
      version_extractors: [
        {
          body_sha256_hash: "5e6f71c2020faf0af5d2720805774b8421562727e5f1ea8daeab318e9c71d762"
          static_versions: ["3.9.15"]
