  },
  # Standalone Control Panel login check (when /cpresources/ assets are served from an external CDN).
  {
    name: "craftcms_admin_login"
    path_suffix: "/admin/login"
    response: {
      status_codes: [200, 503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.LoginForm"
          },
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            regexp: "Craft isn(?:'|’)t installed yet"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
    }
  },
  # Standalone pending-install or offline 503 root page check (when /cpresources/ is on an external CDN).
  {
    name: "craftcms_offline_root"
    path: "/"
    response: {
      status_codes: [503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
    }
  },
  # Standalone Control Panel web installer check (when /cpresources/ is on an external CDN).
  {
    name: "craftcms_admin_install"
    path_suffix: "/admin/install"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:install|cp)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.Installer"
          },
          {
            body: {}
            contains: "<title>Install Craft CMS"
          },
          {
            body: {}
            contains: "begininstall"
          }
        ]
      }
    }
  },
  # Default Welcome template rendered on freshly installed Craft CMS 3.x, 4.x, and 5.x instances.
  {
    name: "craftcms_welcome_root"
    path: "/"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "<title>Welcome to Craft CMS</title>"
          },
          {
            body: {}
            contains: "Thanks for installing Craft CMS!"
          },
          {
            body: {}
            regexp: "href=[\"']https://craftcms\\.com/docs/"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/"
          },
          {
            body: {}
            regexp: "(?i)Go to your control panel"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          }
        ]
      }
    }
  },
  # Anonymous UsersController::actionSessionInfo JSON endpoint (/actions/users/session-info).
  # Detects installed Craft CMS 3.x, 4.x, and 5.x sites even when front-end templates are customized
  # and the Control Panel trigger (/admin) is renamed or restricted.
  {
    name: "craftcms_users_session_info"
    path: "/actions/users/session-info"
    headers: [
      { name: "Accept" value: "application/json" }
    ]
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "application/json"
          },
          {
            body: {}
            regexp: "\"isGuest\"\\s*:\\s*(?:true|false)"
          },
          {
            body: {}
            contains: "\"csrfTokenValue\""
          },
          {
            body: {}
            contains: "\"timeout\""
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "\"CRAFT_CSRF_TOKEN\""
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
    }
  },
  # Standalone non-rewrite Control Panel login check (/index.php?p=admin/login).
  {
    name: "craftcms_index_php_admin_login"
    path: "/index.php?p=admin/login"
    response: {
      status_codes: [200, 503]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.LoginForm"
          },
          {
            body: {}
            contains: "CRAFT_CSRF_TOKEN"
          },
          {
            body: {}
            regexp: "Craft isn(?:'|’)t installed yet"
          },
          {
            body: {}
            contains: "<title>Service Unavailable"
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          }
        ]
      }
    }
  },
  # Standalone non-rewrite Control Panel installer check (/index.php?p=admin/install).
  {
    name: "craftcms_index_php_admin_install"
    path: "/index.php?p=admin/install"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "window\\.Craft\\s*=\\s*\\{"
          },
          {
            body: {}
            regexp: "\"baseApiUrl\"\\s*:\\s*\"https?:\\\\?/\\\\?/api\\.craftcms\\.com\\\\?/v[0-9]+"
          },
          {
            body: {}
            regexp: "/cpresources/[0-9a-f]+/(?:install|cp)\\.js"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.Installer"
          },
          {
            body: {}
            contains: "<title>Install Craft CMS"
          },
          {
            body: {}
            contains: "begininstall"
          }
        ]
      }
    }
  },
  # Non-rewrite UsersController::actionSessionInfo JSON endpoint (/index.php?p=actions/users/session-info).
  {
    name: "craftcms_index_php_users_session_info"
    path: "/index.php?p=actions/users/session-info"
    headers: [
      { name: "Accept" value: "application/json" }
    ]
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "application/json"
          },
          {
            body: {}
            regexp: "\"isGuest\"\\s*:\\s*(?:true|false)"
          },
          {
            body: {}
            contains: "\"csrfTokenValue\""
          },
          {
            body: {}
            contains: "\"timeout\""
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "\"CRAFT_CSRF_TOKEN\""
          },
          {
            header: { name: "Set-Cookie" }
            regexp: "(?:CRAFT_CSRF_TOKEN|CraftSessionId)="
          },
          {
            header: { name: "X-Powered-By" }
            contains: "Craft CMS"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
    }
  },
  # Non-rewrite pending-install JSON 503 check on Control Panel session-info route
  # (/index.php?p=admin/actions/users/session-info returns {"message":"Craft isn’t installed yet."}).
  {
    name: "craftcms_index_php_admin_session_info_uninstalled"
    path: "/index.php?p=admin/actions/users/session-info"
    headers: [
      { name: "Accept" value: "application/json" }
    ]
    response: {
      status_codes: [503]
      expect_all: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "application/json"
          },
          {
            body: {}
            contains: "\"Service Unavailable\""
          },
          {
            body: {}
            regexp: "\"message\"\\s*:\\s*\"Craft isn(?:'|’)t installed yet\\.\""
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
    }
  },
  # Passive subpath discovery and cryptographic verification via Craft CMS Control Panel favicon
  # (identical SHA-256 across Craft CMS 3.x, 4.x, and 5.x).
  {
    name: "craftcms_cpresources_favicon"
    path_regexp: "/cpresources/[0-9a-f]+/images/icons/favicon\\.ico$"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            hash: {
              body_sha256_hashes: [
                "0d9545cf81cfb8ee346dea824d7953c61a40b604ad51b06e476a04156a8b7551"
              ]
            }
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
    }
  }
]

workflows: [
  # Control Panel login (200 installed / 503 pending-install or offline) + cp.js version extraction.
  {
    steps: [
      "craftcms_admin_login_extract_cp_js",
      "craftcms_cp_js_version"
    ]
  },
  # Pending-install / offline 503 root page + cp.js version extraction.
  {
    steps: [
      "craftcms_offline_root_extract_cp_js",
      "craftcms_cp_js_version"
    ]
  },
  # Pending-install web installer (/admin/install) + cp.js version extraction.
  {
    steps: [
      "craftcms_admin_install_extract_cp_js",
      "craftcms_cp_js_version"
    ]
  },
  # Non-rewrite Control Panel login (/index.php?p=admin/login) + cp.js version extraction.
  {
    steps: [
      "craftcms_index_php_admin_login_extract_cp_js",
      "craftcms_cp_js_version"
    ]
  },
  # Non-rewrite Control Panel installer (/index.php?p=admin/install) + cp.js version extraction.
  {
    steps: [
      "craftcms_index_php_admin_install_extract_cp_js",
      "craftcms_cp_js_version"
    ]
  },
  # Passive /cpresources/<hex>/ core JS asset detection and cp.js version extraction.
  {
    steps: ["craftcms_cpresources_js_asset"]
  },
  # Standalone Control Panel login fallback (e.g. external CDN for /cpresources/).
  {
    steps: ["craftcms_admin_login"]
  },
  # Standalone pending-install / offline 503 root page fallback.
  {
    steps: ["craftcms_offline_root"]
  },
  # Standalone Control Panel web installer fallback.
  {
    steps: ["craftcms_admin_install"]
  },
  # Default Welcome page on freshly installed Craft CMS root.
  {
    steps: ["craftcms_welcome_root"]
  },
  # Unauthenticated /actions/users/session-info JSON check (custom frontend + custom cpTrigger).
  {
    steps: ["craftcms_users_session_info"]
  },
  # Non-rewrite standalone Control Panel login fallback.
  {
    steps: ["craftcms_index_php_admin_login"]
  },
  # Non-rewrite standalone Control Panel installer fallback.
  {
    steps: ["craftcms_index_php_admin_install"]
  },
  # Non-rewrite installed session-info JSON fallback.
  {
    steps: ["craftcms_index_php_users_session_info"]
  },
  # Non-rewrite pending-install 503 JSON session-info fallback.
  {
    steps: ["craftcms_index_php_admin_session_info_uninstalled"]
  },
  # Passive /cpresources/<hex>/images/icons/favicon.ico paired with session-info or admin login.
  {
    steps: [
      "craftcms_cpresources_favicon",
      "craftcms_users_session_info"
    ]
  },
  {
    steps: [
      "craftcms_cpresources_favicon",
      "craftcms_admin_login"
    ]
  }
]
