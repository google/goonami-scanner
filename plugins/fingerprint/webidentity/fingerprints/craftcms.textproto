  # Passive subpath discovery and verification via published Craft CMS /cpresources/<hex>/ JS bundles
  # (note: Yii2 crc32 hex directory hashes can be 6-8 hex characters, e.g. 57abd98 in Craft 5).
  {
    name: "craftcms_cpresources_js_asset"
    path_regexp: "/cpresources/[0-9a-f]+/(?:cp|garnish|login|install)\\.js$"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            regexp: "Garnish\\.(?:Base|Modal)"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "Craft.Accordion"
          },
          {
            body: {}
            contains: "Craft.LoginForm"
          },
          {
            body: {}
            contains: "Craft.Installer"
          },
          {
            body: {}
            contains: "Garnish.$win"
          },
          {
            body: {}
            contains: "garnish.js.LICENSE.txt"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)<!doctype\\s+html|<html[\\s>]"
          }
        ]
      }
      version_extractors: [
        {
          body_sha256_hash: "5e6f71c2020faf0af5d2720805774b8421562727e5f1ea8daeab318e9c71d762"
          static_versions: ["3.9.15"]
