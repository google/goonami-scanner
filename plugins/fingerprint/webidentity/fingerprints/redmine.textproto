          static_versions: ["3.3.0"]
        },
        {
          murmur3_hash: "c77a72ec98ca25038e4a570cc23a275a"
          static_versions: ["3.3.1"]
        },
        {
          murmur3_hash: "78564ff67e8c83a272dfc39ef1bbc2d9"
          static_versions: ["3.3.2", "3.3.3", "3.3.4", "3.3.5", "3.3.6"]
        },
        {
          murmur3_hash: "32ad6163cde545a7ea804c371959d95d"
          static_versions: ["3.3.7", "3.3.8", "3.3.9", "3.3.10"]
        },
        {
          murmur3_hash: "5fab90efb8319f3b4ac27adf8a35ae62"
          static_versions: ["3.4.0", "3.4.1", "3.4.2"]
        },
        {
          murmur3_hash: "0cfb0d28c78d61a522d5f6b81b10db4f"
          static_versions: ["3.4.3", "3.4.4"]
        },
        {
          murmur3_hash: "fc8c8468dcd7639dd3658909ea9eba21"
          static_versions: ["3.4.5", "3.4.6", "3.4.7", "3.4.8", "3.4.9", "3.4.10", "3.4.11", "3.4.12", "3.4.13"]
        },
        {
          murmur3_hash: "bd332fc4d510e8e76c5d026e9ed44e7f"
          static_versions: ["4.0.0", "4.0.1", "4.0.2", "4.0.3", "4.0.4"]
        },
        {
          murmur3_hash: "e81e173e0dac13909a5d6726bad0fbe8"
          static_versions: ["4.0.5", "4.0.6", "4.0.7"]
