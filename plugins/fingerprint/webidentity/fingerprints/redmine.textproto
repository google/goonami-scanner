  # Dynamic Wiki Syntax Quick Reference controller route in Redmine 6.0+ (/help/wiki_syntax).
  {
    name: "redmine_help_wiki_syntax_controller"
    path_suffix: "/help/wiki_syntax"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "<title>Wiki formatting</title>"
          },
          {
            body: {}
            contains: "Wiki Syntax Quick Reference"
          },
          {
            body: {}
            contains: "Redmine links"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            regexp: "/assets/wiki_syntax-[0-9a-f]{8,64}\\.css"
          },
          {
            body: {}
            regexp: "/assets/jstoolbar/bt_link-[0-9a-f]{8,64}\\.png"
          }
        ]
      }
      version_extractors: [
        {
          body_sha256_hash: "0c782f6bbe1be062e489d72fedcd696d5f58980c93cde9938d4d7011daae608a"
          static_versions: ["6.0.12"]
        }
      ]
    }
  },
  # Redmine Atom syndication feed (/projects.atom) across Redmine 3.x, 4.x, 5.x, and 6.x+.
  {
    name: "redmine_projects_atom"
    path_suffix: "/projects.atom"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "http://www.w3.org/2005/Atom"
          },
          {
            body: {}
            regexp: "<generator\\s+uri=[\"']https?://(?:www\\.)?redmine\\.org/?[\"'][^>]*>\\s*Redmine\\s*</generator>"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)^\\s*(?:<!doctype\\s+html|<html[\\s>])"
          }
        ]
      }
    }
  },
  # Official Redmine favicon.ico (passive subpath discovery and static icon fallback).
  {
    name: "redmine_favicon"
    path_regexp: "^(?P<root>.*?)/(?:favicon|assets/favicon-[0-9a-f]{8,64})\\.ico$"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            hash: {
              murmur3_hashes: [
                "21aef6bbbb078b340a80e19ea55dd2a7",
                "da0f417712c8337b253fa0192a187c1e"
              ]
              body_sha256_hashes: [
                "5210ac65f141394a8540d408a9b56ed64c21c6b212cb28144c874f5715be9ed1"
              ]
            }
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          }
        ]
      }
    }
  }
]

workflows: [
  {
    steps: ["redmine_application_js"]
  },
  {
    steps: ["redmine_propshaft_application_js"]
  },
  {
    steps: [
      "redmine_login_extract_propshaft_js",
      "redmine_propshaft_js_by_var"
    ]
  },
  {
    steps: ["redmine_login_page"]
  },
  {
    steps: ["redmine_root_page"]
  },
  {
    steps: ["redmine_context_menu_js"]
  },
