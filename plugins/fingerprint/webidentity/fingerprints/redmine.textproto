        {
          murmur3_hash: "0b97ffbef11ceb47a28881df200c7a25"
          static_versions: ["4.1.0", "4.1.1"]
        }
      ]
    }
  },
  # Static Wiki Syntax Quick Reference help page in Redmine 3.x, 4.x, and 5.x (public/help/en/wiki_syntax_markdown.html).
  # Served directly from public/ even when Setting.login_required = 1.
  {
    name: "redmine_help_wiki_syntax_markdown"
    path_suffix: "/help/en/wiki_syntax_markdown.html"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "<title>Wiki formatting</title>"
          },
          {
            body: {}
            contains: "Wiki Syntax Quick Reference"
          },
          {
            body: {}
            contains: "Redmine links"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "images/jstoolbar/bt_link.png"
          },
          {
            body: {}
            contains: "wiki_syntax_detailed_markdown.html"
          }
        ]
      }
      version_extractors: [
        {
          body_sha256_hash: "5d07679397fcf436176f591c8317b6ded9e98106beddcca47e6f72d703ec4ed7"
          static_versions: ["3.4.0", "3.4.1", "3.4.2", "3.4.3", "3.4.4", "3.4.5", "3.4.6", "3.4.7", "3.4.8", "3.4.9", "3.4.10", "3.4.11", "3.4.12", "3.4.13"]
