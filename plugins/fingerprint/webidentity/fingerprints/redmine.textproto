        },
        {
          murmur3_hash: "79bf700371d8ded28d103df4aef858cb"
          static_versions: ["4.0.0", "4.0.1"]
        },
        {
          murmur3_hash: "142f600be3bffd1b8a7ed9e10dba2820"
          static_versions: ["4.0.2", "4.0.3", "4.0.4", "4.0.5", "4.0.6", "4.0.7"]
