# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprint

info: {
  name: "Redmine"
  author: "Goonami team"
  software: "redmine"
  description: "Detects Redmine project management and issue tracking web application across unconfigured and configured states and extracts version."
}

steps: [
  # Core Redmine JavaScript bundle in Redmine 3.x, 4.x, and 5.x (public/javascripts/application.js).
  # Served statically regardless of database state, custom themes, or Setting.login_required = 1,
  # and enables passive subpath discovery in Pass 1.
  {
    name: "redmine_application_js"
    path_suffix: "/javascripts/application.js"
    response: {
      status_codes: [200]
      expect_all: {
        conditions: [
          {
            body: {}
            contains: "Redmine - project management software"
          },
          {
            body: {}
            contains: "Jean-Philippe Lang"
          }
        ]
      }
      expect_any: {
        conditions: [
          {
            body: {}
            contains: "warnLeavingUnsaved"
          },
          {
            body: {}
            contains: "keepAnchorOnSignIn"
          },
          {
            body: {}
            contains: "toggleCheckboxesBySelector"
          },
          {
            body: {}
            contains: "setupAjaxIndicator"
          }
        ]
      }
      expect_none: {
        conditions: [
          {
            header: { name: "Content-Type" }
            contains: "text/html"
          },
          {
            body: {}
            regexp: "(?i)^\\s*(?:<!doctype\\s+html|<html[\\s>])"
          }
        ]
      }
      version_extractors: [
        {
          body_sha256_hash: "e4d5d646b6f7e5cdd374ad03ab1481b7e25c603ec6a794853673ba580710372c"
          static_versions: ["3.4.5", "3.4.6", "3.4.7", "3.4.8", "3.4.9", "3.4.10", "3.4.11", "3.4.12", "3.4.13"]
        },
        {
          body_sha256_hash: "3ba4abb63347b7ee4db028b5a19f9c119b0284aa384f9221767630b97658da11"
          static_versions: ["4.2.10"]
        },
        {
          body_sha256_hash: "b9226cd7b24145621781606399697720b02cb3be0a1ec1cbbb16f25d4fe6cade"
          static_versions: ["5.1.12"]
        },
        {
          murmur3_hash: "24fc15a9bc6f936d1aac539d337cb59e"
          static_versions: ["3.0.0", "3.0.1", "3.0.2", "3.0.3"]
        },
        {
          murmur3_hash: "b47f764c732065f5dc5c881bece7106a"
          static_versions: ["3.0.4", "3.0.5", "3.0.6", "3.0.7"]
        },
        {
          murmur3_hash: "a44cb96a1da8d6c17b64df9df364bd2f"
          static_versions: ["3.1.0", "3.1.1"]
        },
        {
          murmur3_hash: "484fee88d365db13153f45e20d73719b"
          static_versions: ["3.1.2", "3.1.3"]
        },
        {
          murmur3_hash: "8d627e29021b5f593c903dad12e2b573"
          static_versions: ["3.1.4", "3.1.5", "3.1.6", "3.1.7"]
        },
        {
          murmur3_hash: "ad4b0aa05e923f43ef2dbcc123126921"
          static_versions: ["3.2.0"]
        },
        {
          murmur3_hash: "504047a02d2484fb598113981f4bff85"
          static_versions: ["3.2.1"]
        },
        {
          murmur3_hash: "b3b2fcd970dbf21b2b0aeaee71bad493"
          static_versions: ["3.2.2", "3.2.3", "3.2.4", "3.2.5", "3.2.6", "3.2.7", "3.2.8", "3.2.9"]
        },
