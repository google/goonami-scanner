        body: "<!DOCTYPE html>\n<html dir=\"ltr\" lang=\"en\">\n<head>\n<title>Home | Moodle45</title>\n<meta name=\"keywords\" content=\"moodle, Home | Moodle45\" />\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://target.test:8080/theme/styles.php/boost/1793808268_1793808283/all\" />\n<script>\nvar M = {}; M.yui = {};\nM.cfg = {\"wwwroot\":\"http:\\/\\/target.test:8080\",\"apibase\":\"http:\\/\\/target.test:8080\\/r.php\\/api\",\"sesskey\":\"KnBJFHjzcO\",\"themerev\":\"1793808268\",\"jsrev\":\"1793808268\"};\n</script>\n</head>\n<body id=\"page-site-index\" class=\"format-site course path-site yui-skin-sam pagelayout-frontpage notloggedin\"><div>Powered by <a href=\"https://moodle.com\">Moodle</a></div></body></html>"
      },
      {
        uri: "/UPGRADING.md"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/markdown" }
        ]
        body: "# Moodle Upgrade notes\n\nThis file contains important information for developers on changes to the Moodle codebase.\n\nMore detailed information on key changes can be found in the [Developer update notes](https://moodledev.io/docs/devupdate) for your version of Moodle.\n\n## 4.5\n\n### core\n\n#### Added\n\n- A new method, `\\core_user::get_name_placeholders()`, has been added.\n  For more information see [MDL-64148](https://tracker.moodle.org/browse/MDL-64148)\n"
      },
      {
        uri: "/lib/upgrade.txt"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/plain" }
        ]
        body: "=== 4.5 Onwards ===\n\nThis file has been replaced by UPGRADING.md. See MDL-81125 for further information.\n\n===\n\nThis files describes API changes in core libraries and APIs,\ninformation provided here is intended especially for developers.\n\n=== 4.4 ===\n\n* New modinfo methods related to delegated sections.\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["4.5"]
      }
    ]
  },
