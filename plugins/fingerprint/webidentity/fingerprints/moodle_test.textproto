tested_fingerprint: "moodle"

tests: [
  {
    name: "moodle_3_11_18_pending_install"
    mock_responses: [
      {
        uri: "/"
        status_code: 302
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" },
          { name: "Location", value: "install.php" }
        ]
        body: ""
      },
      {
        uri: "/install.php"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=UTF-8" }
        ]
        body: "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\"><html dir=\"ltr\">\n<head>\n<link rel=\"shortcut icon\" href=\"http://target.test:8080/theme/boost/pix/favicon.ico\" /><link rel=\"stylesheet\" type=\"text/css\" href=\"http://target.test:8080/install/css.php\" />\n<title>Installation - Moodle 3.11.18 (Build: 20231211)</title>\n</head><body class=\"notloggedin\"><div id=\"page\" class=\"mt-0 container stage0\"><div id=\"page-footer\"><div class=\"sitelink\"><a title=\"Moodle 3.11.18 (Build: 20231211)\" href=\"http://docs.moodle.org/en/Administrator_documentation\"><img src=\"pix/moodlelogo.png\" alt=\"Moodle logo\" /></a></div></div></div></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.11.18"]
      }
    ]
  },
  {
    name: "moodle_3_11_18_installed"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" },
          { name: "Set-Cookie", value: "MoodleSession=25f8643a71784ce4cc29d3639d7c0e4b; path=/" }
        ]
        body: "<!DOCTYPE html>\n<html dir=\"ltr\" lang=\"en\" xml:lang=\"en\">\n<head>\n<title>Test Moodle</title>\n<meta name=\"keywords\" content=\"moodle, Test Moodle\" />\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://target.test:8080/theme/yui_combo.php?rollup/3.17.2/yui-moodlesimple-min.css\" />\n<link rel=\"stylesheet\" type=\"text/css\" href=\"http://target.test:8080/theme/styles.php/boost/1793807864_1793807876/all\" />\n<script>\n//<![CDATA[\nvar M = {}; M.yui = {};\nM.cfg = {\"wwwroot\":\"http:\\/\\/target.test:8080\",\"sesskey\":\"MxicbpPsCv\",\"sessiontimeout\":\"28800\",\"themerev\":\"1793807864\",\"slasharguments\":1,\"theme\":\"boost\",\"iconsystemmodule\":\"core\\/icon_system_fontawesome\",\"jsrev\":\"1793807864\"};\n//]]>\n</script>\n<script src=\"http://target.test:8080/lib/javascript.php/1793807864/lib/javascript-static.js\"></script>\n</head>\n<body id=\"page-site-index\" class=\"format-site course path-site dir-ltr lang-en yui-skin-sam pagelayout-frontpage notloggedin\"></body></html>"
      },
      {
        uri: "/lib/upgrade.txt"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/plain" }
        ]
        body: "This files describes API changes in core libraries and APIs,\ninformation provided here is intended especially for developers.\n\n=== 3.11.18 ===\n* In enrollib.php, the method enrol_get_course_users() got an optional 5th parameter $usergroups.\n\n=== 3.11.17 ===\n* New Behat step added (MDL-76543).\n"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.11.18"]
      }
    ]
  },
