# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "zabbix"

tests: [
  {
    name: "zabbix_5_0_47_configured_login_and_api"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "text/html; charset=UTF-8"
          },
          {
            name: "Set-Cookie"
            value: "zbx_session=eyJzZXNzaW9uaWQiOiI2M2Y1In0%3D; HttpOnly"
          }
        ]
        body: "<!DOCTYPE html>\n<html>\n\t<head>\n\t\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\"/>\n\t\t<meta charset=\"utf-8\" />\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<meta name=\"Author\" content=\"Zabbix SIA\" />\n\t\t<title>Zabbix</title>\n\t\t<link rel=\"icon\" href=\"favicon.ico\">\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"assets/styles/blue-theme.css?1759148625\" />\n\t</head>\n\t<body lang=\"en\">\n\t\t<div class=\"wrapper\"><main><div class=\"server-name\">ZabbixDocker</div><div class=\"signin-container\"><div class=\"signin-logo\"><div class=\"zabbix-logo\"></div></div><form method=\"post\" action=\"index.php\" accept-charset=\"utf-8\" aria-label=\"Sign in\"><ul><li><label for=\"name\">Username</label><input type=\"text\" id=\"name\" name=\"name\" value=\"\" maxlength=\"255\" autofocus=\"autofocus\"></li><li><button type=\"submit\" id=\"enter\" name=\"enter\" value=\"Sign in\">Sign in</button></li></ul></form></div><div class=\"signin-links\"><a target=\"_blank\" rel=\"noopener noreferrer\" class=\"grey link-alt\" href=\"https://www.zabbix.com/documentation/5.0/\">Help</a>&nbsp;&bull;&nbsp;<a target=\"_blank\" rel=\"noopener noreferrer\" class=\"grey link-alt\" href=\"https://www.zabbix.com/support\">Support</a></div></main><footer role=\"contentinfo\">&copy; 2001&ndash;2025, <a class=\"grey link-alt\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.zabbix.com/\">Zabbix SIA</a></footer></div>\n\t</body>\n</html>"
      },
      {
        uri: "/api_jsonrpc.php"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "application/json"
          }
        ]
        body: "{\"jsonrpc\":\"2.0\",\"result\":\"5.0.47\",\"id\":1}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["5.0.47"]
      }
    ]
  },
