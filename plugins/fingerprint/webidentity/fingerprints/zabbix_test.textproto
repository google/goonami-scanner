  {
    name: "zabbix_database_error_page_no_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "text/html; charset=UTF-8"
          }
        ]
        body: "<!DOCTYPE html>\n<html>\n\t<head>\n\t\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\"/>\n\t\t<meta charset=\"utf-8\" />\n\t\t<meta name=\"Author\" content=\"Zabbix SIA\" />\n\t\t<title>Warning [refreshed every 30 sec.]</title>\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"assets/styles/blue-theme.css?1775647992\" />\n<script src=\"js/browsers.js?1775647992\"></script>\n\t</head>\n\t<body lang=\"en\">\n\t\t<div class=\"wrapper\"><main><output class=\"msg-global msg-bad\" role=\"contentinfo\" aria-label=\"Error message\"><span>Database error</span><div class=\"msg-details\"><ul class=\"msg-details-border\"><li>Connection refused</li></ul></div></output></main><footer role=\"contentinfo\">&copy; 2001&ndash;2026, <a class=\"grey link-alt\" href=\"https://www.zabbix.com/\">Zabbix SIA</a></footer></div>\n\t</body>\n</html>"
      },
      {
        uri: "/js/browsers.js"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "application/javascript"
          }
        ]
        body: "/*\n** Zabbix\n** Copyright (C) 2001-2023 Zabbix SIA\n**/\nvar agt = navigator.userAgent.toLowerCase();\nvar warning = (document.cookie.indexOf('browserwarning_ignore') < 0);\nif (warning) {\n\twindow.location.replace('browserwarning.php');\n}\n"
      },
      {
        uri: "/api_jsonrpc.php"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "application/json"
          }
        ]
        body: "{\"jsonrpc\":\"2.0\",\"error\":{\"code\":-32603,\"message\":\"Internal error.\",\"data\":\"Connection refused\"},\"id\":1}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
      }
    ]
  },
