        uri: "/"
        status_code: 200
        headers: [
          {
            name: "Content-Type"
            value: "text/html; charset=UTF-8"
          }
        ]
        body: "<!DOCTYPE html>\n<html>\n\t<head>\n\t\t<meta http-equiv=\"X-UA-Compatible\" content=\"IE=Edge\"/>\n\t\t<meta charset=\"utf-8\" />\n\t\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n\t\t<meta name=\"Author\" content=\"Zabbix SIA\" />\n\t\t<title>Installation</title>\n\t\t<link rel=\"icon\" href=\"favicon.ico\">\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"assets/styles/blue-theme.css?1759148625\" />\n<script src=\"js/browsers.js?1759148625\"></script>\n<script src=\"jsLoader.php?ver=5.0.47&amp;lang=en_gb\"></script>\n<script src=\"jsLoader.php?ver=5.0.47&amp;lang=en_gb&amp;files%5B0%5D=setup.js\"></script>\n\t</head>\n\t<body lang=\"en\">\n\t\t<div class=\"wrapper\"><form method=\"post\" action=\"setup.php\"><div class=\"setup-container\"><div class=\"setup-left\"><div class=\"setup-logo\"><div class=\"zabbix-logo\"></div></div><ul><li class=\"setup-left-current\">1. Welcome</li><li>2. Check of pre-requisites</li></ul></div><div class=\"setup-right\"><div class=\"setup-right-body\"><div class=\"setup-title\"><span>Welcome to</span>Zabbix 5.0</div></div></div></div></form><footer role=\"contentinfo\">Zabbix 5.0.47. &copy; 2001&ndash;2025, <a class=\"grey link-alt\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.zabbix.com/\">Zabbix SIA</a></footer></div>\n\t</body>\n</html>"
      },
