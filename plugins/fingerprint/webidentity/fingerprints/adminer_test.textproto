  {
    name: "negative_blog_post_mentioning_adminer"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html; charset=utf-8" }
        ]
        body: "<!DOCTYPE html><html><head><title>How to secure Adminer 6.2.0</title></head><body><h1>Hardening Adminer (https://www.adminer.org/)</h1><p>Adminer loads assets like <code>?file=default.css&amp;version=6.2.0</code> and <code>?file=functions.js&amp;version=6.2.0</code> from a single PHP file.</p></body></html>"
      }
