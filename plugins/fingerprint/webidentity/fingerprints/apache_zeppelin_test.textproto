  {
    name: "zeppelin_0_12_1_anonymous_angular_ui_and_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=utf-8" },
          { name: "Server", value: "Jetty(11.0.24)" }
        ]
        body: "<!DOCTYPE html><html lang=\"en\" class=\"light\"><head><meta charset=\"utf-8\"><link rel=\"icon\" href=\"./assets/images/zeppelin.png\" type=\"image/x-icon\"><title>Zeppelin</title><script>(function(){const savedTheme = localStorage.getItem('zeppelin-theme');})();</script></head><body><zeppelin-root><section class=\"spin\"><div><div class=\"logo\"></div><div class=\"spin-text\"><h1 class=\"brand-title\" style=\"display: none\">Zeppelin</h1><span class=\"status\" style=\"display: none\">Booting ...</span></div></div></section></zeppelin-root><script src=\"runtime.7ffe26d4336ab203.js\" type=\"module\"></script><script src=\"main.fe4a8dd370396752.js\" type=\"module\"></script></body></html>"
      },
      {
        uri: "/main.fe4a8dd370396752.js"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/javascript" },
          { name: "Server", value: "Jetty(11.0.24)" }
        ]
        body: "(self.webpackChunkzeppelin=self.webpackChunkzeppelin||[]).push([[179],{98809:function(){this.__zeppelinMessageListeners$__=null;var docs='https://zeppelin.apache.org/'}}]);"
      },
      {
        uri: "/api/security/ticket"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "application/json" }
        ]
        body: "{\"status\":\"OK\",\"message\":\"\",\"body\":{\"principal\":\"anonymous\",\"ticket\":\"anonymous\",\"roles\":\"[]\"}}"
      },
      {
        uri: "/api/version"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/plain" },
          { name: "Server", value: "Jetty(11.0.24)" }
        ]
        body: "{\"status\":\"OK\",\"message\":\"Zeppelin version\",\"body\":{\"git-commit-id\":\"\",\"git-timestamp\":\"\",\"version\":\"0.12.1\"}}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["0.12.1"]
      }
    ]
  },
