# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "spark"

tests: [
  {
    name: "spark_3_1_3_standalone_master_unconfigured_idle_ui"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html;charset=utf-8" },
          { name: "Cache-Control" value: "no-cache, no-store, must-revalidate" },
          { name: "X-Frame-Options" value: "SAMEORIGIN" }
        ]
        body: "<!DOCTYPE html><html>\n      <head>\n        <meta http-equiv=\"Content-type\" content=\"text/html; charset=utf-8\"/><link rel=\"stylesheet\" href=\"/static/bootstrap.min.css\" type=\"text/css\"/><link rel=\"stylesheet\" href=\"/static/webui.css\" type=\"text/css\"/><script src=\"/static/webui.js\"></script><script>setUIRoot('')</script>\n        <title>Spark Master at spark://10.88.0.4:7077</title>\n      </head>\n      <body>\n        <div class=\"container-fluid\">\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <h3 style=\"vertical-align: middle; display: inline-block;\">\n                <a style=\"text-decoration: none\" href=\"/\">\n                  <img src=\"/static/spark-logo-77x50px-hd.png\"/>\n                  <span class=\"version\" style=\"margin-right: 15px;\">3.1.3</span>\n                </a>\n                Spark Master at spark://10.88.0.4:7077\n              </h3>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <ul class=\"list-unstyled\">\n                <li><strong>URL:</strong> spark://10.88.0.4:7077</li>\n                <li><strong>Alive Workers:</strong> 0</li>\n                <li><strong>Status:</strong> ALIVE</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </body>\n    </html>"
      },
      {
        uri: "/json/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/json;charset=utf-8" }
        ]
        body: "{\n  \"url\" : \"spark://10.88.0.4:7077\",\n  \"workers\" : [ ],\n  \"aliveworkers\" : 0,\n  \"cores\" : 0,\n  \"coresused\" : 0,\n  \"memory\" : 0,\n  \"memoryused\" : 0,\n  \"activeapps\" : [ ],\n  \"completedapps\" : [ ],\n  \"activedrivers\" : [ ],\n  \"completeddrivers\" : [ ],\n  \"status\" : \"ALIVE\"\n}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.1.3"]
      }
    ]
  },
  {
    name: "spark_3_3_0_standalone_master_configured_cluster_with_worker_and_rest_url"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html;charset=utf-8" },
          { name: "X-Frame-Options" value: "SAMEORIGIN" }
        ]
        body: "<!DOCTYPE html><html>\n      <head>\n        <meta http-equiv=\"Content-type\" content=\"text/html; charset=utf-8\"/><link rel=\"stylesheet\" href=\"/static/bootstrap.min.css\" type=\"text/css\"/><link rel=\"stylesheet\" href=\"/static/webui.css\" type=\"text/css\"/><script src=\"/static/webui.js\"></script><script>setUIRoot('')</script>\n        <title>Spark Master at spark://10.88.0.5:7077</title>\n      </head>\n      <body>\n        <div class=\"container-fluid\">\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <h3 style=\"vertical-align: middle; display: inline-block;\">\n                <a style=\"text-decoration: none\" href=\"/\">\n                  <img src=\"/static/spark-logo-77x50px-hd.png\"/>\n                  <span class=\"version\" style=\"margin-right: 15px;\">3.3.0</span>\n                </a>\n                Spark Master at spark://10.88.0.5:7077\n              </h3>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <ul class=\"list-unstyled\">\n                <li><strong>URL:</strong> spark://10.88.0.5:7077</li>\n                <li><strong>REST URL:</strong> spark://10.88.0.5:6066 <span class=\"rest-uri\"> (cluster mode)</span></li>\n                <li><strong>Alive Workers:</strong> 1</li>\n                <li><strong>Status:</strong> ALIVE</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </body>\n    </html>"
      },
      {
        uri: "/json/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/json;charset=utf-8" }
        ]
        body: "{\n  \"url\" : \"spark://10.88.0.5:7077\",\n  \"workers\" : [ {\n    \"id\" : \"worker-20261105095512-10.88.0.5-36021\",\n    \"host\" : \"10.88.0.5\",\n    \"port\" : 36021,\n    \"webuiaddress\" : \"http://10.88.0.5:8081\",\n    \"cores\" : 2,\n    \"coresused\" : 0,\n    \"coresfree\" : 2,\n    \"memory\" : 1024,\n    \"memoryused\" : 0,\n    \"memoryfree\" : 1024,\n    \"state\" : \"ALIVE\",\n    \"lastheartbeat\" : 1793872515000\n  } ],\n  \"aliveworkers\" : 1,\n  \"cores\" : 2,\n  \"coresused\" : 0,\n  \"memory\" : 1024,\n  \"memoryused\" : 0,\n  \"activeapps\" : [ ],\n  \"completedapps\" : [ ],\n  \"activedrivers\" : [ ],\n  \"completeddrivers\" : [ ],\n  \"status\" : \"ALIVE\"\n}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.3.0"]
      }
    ]
  },
  {
