          { name: "X-Frame-Options" value: "SAMEORIGIN" }
        ]
        body: ""
      },
      {
        uri: "/jobs/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html;charset=utf-8" },
          { name: "X-Frame-Options" value: "SAMEORIGIN" }
        ]
        body: "<!DOCTYPE html><html>\n      <head>\n        <meta http-equiv=\"Content-type\" content=\"text/html; charset=utf-8\"/><link rel=\"stylesheet\" href=\"/static/bootstrap.min.css\" type=\"text/css\"/><link rel=\"stylesheet\" href=\"/static/webui.css\" type=\"text/css\"/><script src=\"/static/webui.js\"></script><script>setUIRoot('');setAppBasePath('')</script>\n        <title>Spark shell - Spark Jobs</title>\n      </head>\n      <body>\n        <nav class=\"navbar navbar-expand-md navbar-light bg-light\">\n          <div class=\"navbar-brand\">\n            <a href=\"/\" class=\"brand\">\n              <img src=\"/static/spark-logo-77x50px-hd.png\" title=\"Spark 4.0.0\"/>\n            </a>\n          </div>\n          <span class=\"navbar-text\">\n            <strong title=\"Spark shell\">Spark shell</strong> application UI\n          </span>\n          <div class=\"collapse navbar-collapse\">\n            <p class=\"navbar-text\" style=\"margin-bottom:0\">\n              <strong style=\"margin-right:5px;\">Spark</strong>\n              <span class=\"version\">4.0.0</span>\n            </p>\n          </div>\n        </nav>\n      </body>\n    </html>"
      },
      {
        uri: "/api/v1/version"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json" }
        ]
        body: "{\n  \"spark\" : \"4.0.0\"\n}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["4.0.0"]
      }
    ]
  },
  {
    name: "spark_4_0_0_standalone_rest_submission_server_root_error"
    mock_responses: [
