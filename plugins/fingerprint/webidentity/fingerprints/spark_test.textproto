        body: "{\n  \"action\" : \"ErrorResponse\",\n  \"message\" : \"Missing protocol version. Please submit requests through http://[host]:[port]/v1/submissions/...\",\n  \"serverSparkVersion\" : \"4.0.0\"\n}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["4.0.0"]
      }
    ]
  },
