        ]
        body: "{\n  \"id\" : \"worker-20261105095711-10.88.0.6-35093\",\n  \"masterurl\" : \"spark://0.0.0.0:7077\",\n  \"masterwebuiurl\" : \"http://10.88.0.6:8080\",\n  \"cores\" : 2,\n  \"coresused\" : 0,\n  \"memory\" : 1024,\n  \"memoryused\" : 0,\n  \"executors\" : [ ],\n  \"finishedexecutors\" : [ ]\n}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["3.4.4"]
      }
    ]
  },
  {
    name: "spark_3_5_4_history_server_ui_and_api_v1_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "text/html;charset=utf-8" },
          { name: "X-Frame-Options" value: "SAMEORIGIN" }
        ]
        body: "<!DOCTYPE html><html>\n      <head>\n        <meta http-equiv=\"Content-type\" content=\"text/html; charset=utf-8\"/><link rel=\"stylesheet\" href=\"/static/bootstrap.min.css\" type=\"text/css\"/><link rel=\"stylesheet\" href=\"/static/webui.css\" type=\"text/css\"/><script src=\"/static/webui.js\"></script><script>setUIRoot('')</script>\n        <title>History Server</title>\n      </head>\n      <body>\n        <div class=\"container-fluid\">\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <h3 style=\"vertical-align: middle; display: inline-block;\">\n                <a style=\"text-decoration: none\" href=\"/\">\n                  <img src=\"/static/spark-logo-77x50px-hd.png\"/>\n                  <span class=\"version\" style=\"margin-right: 15px;\">3.5.4</span>\n                </a>\n                History Server\n              </h3>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <ul class=\"list-unstyled\">\n                <li><strong>Event log directory:</strong> file:/tmp/spark-events</li>\n              </ul>\n              <script src=\"/static/historypage-common.js\"></script>\n            </div>\n          </div>\n        </div>\n      </body>\n    </html>"
      },
