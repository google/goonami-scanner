        ]
        body: "<!DOCTYPE html><html>\n      <head>\n        <meta http-equiv=\"Content-type\" content=\"text/html; charset=utf-8\"/><link rel=\"stylesheet\" href=\"/static/bootstrap.min.css\" type=\"text/css\"/><link rel=\"stylesheet\" href=\"/static/webui.css\" type=\"text/css\"/><script src=\"/static/webui.js\"></script><script>setUIRoot('')</script>\n        <title>Spark Worker at 10.88.0.6:35093</title>\n      </head>\n      <body>\n        <div class=\"container-fluid\">\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <h3 style=\"vertical-align: middle; display: inline-block;\">\n                <a style=\"text-decoration: none\" href=\"/\">\n                  <img src=\"/static/spark-logo-77x50px-hd.png\"/>\n                  <span class=\"version\" style=\"margin-right: 15px;\">3.4.4</span>\n                </a>\n                Spark Worker at 10.88.0.6:35093\n              </h3>\n            </div>\n          </div>\n          <div class=\"row\">\n            <div class=\"col-12\">\n              <ul class=\"list-unstyled\">\n                <li><strong>ID:</strong> worker-20261105095711-10.88.0.6-35093</li>\n                <li><strong>Master URL:</strong> spark://0.0.0.0:7077</li>\n              </ul>\n              <p><a href=\"http://10.88.0.6:8080\">Back to Master</a></p>\n            </div>\n          </div>\n        </div>\n      </body>\n    </html>"
