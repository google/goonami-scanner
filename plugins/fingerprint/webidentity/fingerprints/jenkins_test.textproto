# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "jenkins"

tests: [
  {
    name: "v2_249_3_setup_wizard_root_403_and_login"
    mock_responses: [
      {
        uri: "/"
        status_code: 403
        headers: [
          { name: "Content-Type", value: "text/html;charset=utf-8" },
          { name: "X-Hudson", value: "1.395" },
          { name: "X-Jenkins", value: "2.249.3" },
          { name: "X-Jenkins-Session", value: "29ee89fb" }
        ]
        body: "<html><head><meta http-equiv='refresh' content='1;url=/login?from=%2F'/><script>window.location.replace('/login?from=%2F');</script></head><body style='background-color:white; color:white;'>\n\n\nAuthentication required\n<!--\nYou are authenticated as: anonymous\n-->\n</body></html>"
      },
      {
        uri: "/login"
        status_code: 200
        headers: [
          { name: "Content-Type", value: "text/html;charset=utf-8" },
          { name: "X-Hudson", value: "1.395" },
          { name: "X-Jenkins", value: "2.249.3" },
          { name: "X-Jenkins-Session", value: "29ee89fb" }
        ]
        body: "<!DOCTYPE html><html><head resURL=\"/static/29ee89fb\" data-rooturl=\"\" data-resurl=\"/static/29ee89fb\" data-imagesurl=\"/static/29ee89fb/images\"><title>Sign in [Jenkins]</title></head><body data-model-type=\"jenkins.install.SetupWizard\" class=\"install-wizard\" data-version=\"2.249.3\"><form method=\"POST\" action=\"j_acegi_security_check\"><h1>Unlock Jenkins</h1><input id=\"security-token\" class=\"form-control\" type=\"password\" name=\"j_password\"/></form></body></html>"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.249.3"]
      }
    ]
  },
  {
    name: "v2_580_2_setup_wizard_headers_stripped_login"
    mock_responses: [
