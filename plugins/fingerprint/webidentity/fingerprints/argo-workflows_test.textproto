# proto-file: goonami/plugins/fingerprint/webidentity/fingerprint_test.proto
# proto-message: goonami.proto.plugins.webidentity.WebFingerprintTests

tested_fingerprint: "argo_workflows"

tests: [
  {
    name: "argo_workflows_v2_11_8_server_mode_ui_and_version"
    mock_responses: [
      {
        uri: "/"
        status_code: 200
        headers: [
          { name: "Content-Security-Policy" value: "default-src 'self' 'unsafe-inline'; img-src 'self' data:" },
          { name: "Content-Type" value: "text/html; charset=utf-8" },
          { name: "X-Frame-Options" value: "DENY" }
        ]
        body: "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <title>Argo</title>\n    <base href=\"/\">\n    <link href=\"assets/styles/heebo.css\" rel=\"stylesheet\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <meta name=\"robots\" content=\"noindex\">\n    <link rel=\"icon\" type=\"image/png\" href=\"assets/favicon/favicon-32x32.png\" sizes=\"32x32\">\n    <link rel=\"icon\" type=\"image/png\" href=\"assets/favicon/favicon-16x16.png\" sizes=\"16x16\">\n</head>\n\n<body>\n    <div id=\"app\"></div>\n<script type=\"text/javascript\" src=\"main.44d1c937d2b2bb2c533b.js\"></script></body>\n\n</html>"
      },
      {
        uri: "/main.44d1c937d2b2bb2c533b.js"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/javascript" }
        ]
        body: "(window.webpackJsonp=window.webpackJsonp||[]).push([[0],{label:\"workflows.argoproj.io/phase\",docs:\"https://argoproj.github.io/argo\",endpoints:[\"api/v1/workflow-templates\",\"api/v1/cron-workflows\",\"api/v1/archived-workflows\"],kind:\"ClusterWorkflowTemplate\"}]);"
      },
      {
        uri: "/api/v1/version"
        status_code: 200
        headers: [
          { name: "Content-Type" value: "application/json" },
          { name: "Grpc-Metadata-Content-Type" value: "application/grpc" }
        ]
        body: "{\"version\":\"v2.11.8\",\"buildDate\":\"2020-11-21T03:27:28Z\",\"gitCommit\":\"310e099f82520030246a7c9d66f3efaadac9ade2\",\"gitTag\":\"v2.11.8\",\"gitTreeState\":\"clean\",\"goVersion\":\"go1.13.4\",\"compiler\":\"gc\",\"platform\":\"linux/amd64\"}"
      }
    ]
    expected_matches: [
      {
        application_root_path: ""
        expected_versions: ["2.11.8"]
      }
    ]
  },
