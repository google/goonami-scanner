tests: {
  name: "whenNotGitLab_returnsFalse"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/-/manifest.json"
        status: 404
        body_content: "Not Found"
      },
      {
        uri: "/users/sign_in"
        status: 404
        body_content: "Not Found"
      },
      {
        uri: "/explore"
        status: 404
        body_content: "Not Found"
      }
    ]
  }
}
