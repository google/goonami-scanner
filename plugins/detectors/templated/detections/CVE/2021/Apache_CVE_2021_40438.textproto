# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Apache_CVE_2021_40438"
  author: "Tsunami Team (tsunami-dev@google.com)"
  version: "0.1"
  description: "Detects server-side request forgery vulnerability in Apache (CVE-2021-40438)"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "APACHE_SSRF_CVE-2021-40438"
  }
  severity: CRITICAL
  title: "Server-side request forgery (SSRF) in Apache mod_proxy"
  description:
    "The scanner detected that attackers can craft a uri to the Apache webserver which causes"
    " mod_proxy to forward the request to an origin server chosen by the attacker."
    " this issue affects Apache HTTP server 2.4.48 and earlier."
  recommendation: "Upgrade to Apache 2.4.49 or greater."
  related_id: {
    publisher: "CVE"
    value: "CVE-2021-40438"
  }
}

###########
