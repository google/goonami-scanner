# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "Drupal_CVE_2019_6340"
}

tests: {
  name: "whenVulnerable_returnsTrue"
  expect_vulnerability: true

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        headers: [
          { name: "X-Generator" value: "Drupal 8 (https://www.drupal.org)" }
        ]
        body_content: "Drupal site"
      },
      {
        uri: "/node?_format=hal_json"
        status: 401
        body_content: "{\"message\":\"No authentication credentials provided.\"} PHP Version 7.2.15 Server API => Apache 2.0 Handler"
      }
    ]
  }
}

tests: {
  name: "whenNotVulnerable_returnsFalse"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/"
        status: 200
        headers: [
          { name: "X-Generator" value: "Drupal 8 (https://www.drupal.org)" }
        ]
        body_content: "Drupal site"
      },
      {
        uri: "/node?_format=hal_json"
        status: 401
        body_content: "{\"message\":\"No authentication credentials provided.\"}"
      }
    ]
  }
}

tests: {
  name: "whenRandomServer_returnsFalse"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "TSUNAMI_MAGIC_ANY_URI"
        status: 200
        body_content: "Hello world"
      }
    ]
  }
}
