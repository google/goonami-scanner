# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin_tests.proto
# proto-message: TemplatedPluginTests

config: {
  tested_plugin: "SpringBootActuator_ExposedUI"
}

tests: {
  name: "whenActuatorHeapdumpExposed_returnsVulnerable"
  expect_vulnerability: true

  mock_http_server: {
    mock_responses: [
      {
        uri: "/actuator/heapdump"
        status: 200
        headers: [
          {
            name: "Content-Disposition"
            value: "attachment; filename=\"heapdump2020-06-15-09-20-live3506123733943811331.hprof.gz\""
          }
        ]
        body_content: "JAVA PROFILE 1.0.2"
      }
    ]
  }
}

tests: {
  name: "whenLegacyHeapdumpExposed_returnsVulnerable"
  expect_vulnerability: true

  mock_http_server: {
    mock_responses: [
      {
        uri: "/actuator/heapdump"
        status: 404
        body_content: "{\"status\":404,\"error\":\"Not Found\"}"
      },
      {
        uri: "/heapdump"
        status: 200
        headers: [
          {
            name: "Content-Disposition"
            value: "attachment; filename=\"heapdump2021-03-10-12-00-live12345.hprof\""
          }
        ]
        body_content: "JAVA PROFILE 1.0.2"
      }
    ]
  }
}

tests: {
  name: "whenEndpointNotFound_returnsNotVulnerable"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/actuator/heapdump"
        status: 404
        body_content: "{\"status\":404,\"error\":\"Not Found\"}"
      },
      {
        uri: "/heapdump"
        status: 404
        body_content: "{\"status\":404,\"error\":\"Not Found\"}"
      }
    ]
  }
}

tests: {
  name: "whenHeaderDoesNotMatchHeapdump_returnsNotVulnerable"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/actuator/heapdump"
        status: 200
        headers: [
          {
            name: "Content-Disposition"
            value: "attachment; filename=\"backup_database.zip\""
          }
        ]
        body_content: "PK\003\004"
      },
      {
        uri: "/heapdump"
        status: 200
        headers: [
          {
            name: "Content-Disposition"
            value: "attachment; filename=\"backup_database.zip\""
          }
        ]
        body_content: "PK\003\004"
      }
    ]
  }
}

tests: {
  name: "whenServerReturns500_returnsNotVulnerable"
  expect_vulnerability: false

  mock_http_server: {
    mock_responses: [
      {
        uri: "/actuator/heapdump"
        status: 500
        body_content: "{\"status\":500,\"error\":\"Internal Server Error\"}"
      },
      {
        uri: "/heapdump"
        status: 500
        body_content: "{\"status\":500,\"error\":\"Internal Server Error\"}"
      }
    ]
  }
}
