# proto-file: github.com/google/tsunami-security-scanner-plugins/templated/templateddetector/proto/templated_plugin.proto
# proto-message: TemplatedPlugin

###############
# PLUGIN INFO #
###############

info: {
  type: VULN_DETECTION
  name: "KeycloakTemplatedWeakCredentials"
  author: "Tsunami developer team <tsunami-dev@google.com>"
  version: "1.0"
}

finding: {
  main_id: {
    publisher: "GOOGLE"
    value: "WEAK_CREDENTIALS_FOR_KEYCLOAK"
  }
  severity: CRITICAL
  title: "Weak 'keycloak' service credential"
  description: "Well known or weak credentials are detected for 'keycloak' service."
  recommendation: "Change the password of all affected users to a strong one."
}

config: {}

service_information: {
  authentication_type: AUTHENTICATION_TYPE_USERNAME_PASSWORD
  default_credentials: [
    { login: "admin" password: "admin" },
    { login: "admin" password: "password" },
    { login: "admin" password: "keycloak" },
    { login: "username" password: "admin" },
    { login: "username" password: "password" },
    { login: "username" password: "keycloak" },
    { login: "avery" password: "admin" },
    { login: "avery" password: "password" },
    { login: "avery" password: "keycloak" }
  ]
}

###########
# ACTIONS #
###########

actions: {
  name: "check_keycloak"
  action_phase: ACTION_PHASE_FINGERPRINT
  http_request: {
    method: GET
    uri: [
      "/realms/master/.well-known/openid-configuration",
      "/auth/realms/master/.well-known/openid-configuration"
    ]
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "\"issuer\"" },
          { body: {} contains: "\"authorization_endpoint\"" },
          { body: {} contains: "\"token_endpoint\"" },
          { body: {} contains: "/realms/master" }
        ]
      }
    }
  }
}

actions: {
  name: "attempt_login"
  http_request: {
    method: POST
    uri: [
      "/realms/master/protocol/openid-connect/token",
      "/auth/realms/master/protocol/openid-connect/token"
    ]
    headers: [
      { name: "Content-Type" value: "application/x-www-form-urlencoded" }
    ]
    data: "grant_type=password&client_id=admin-cli&username={{ T_USERNAME }}&password={{ T_PASSWORD }}"
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "\"access_token\"" }
        ]
      }
      extract_all: {
        patterns: [
          {
            from_body: {}
            regexp: "\"access_token\"\\s*:\\s*\"([^\"]+)\""
            variable_name: "access_token"
          }
        ]
      }
    }
  }
}

actions: {
  name: "verify_login"
  http_request: {
    method: GET
    uri: [
      "/admin/realms/master",
      "/auth/admin/realms/master"
    ]
    headers: [
      { name: "Authorization" value: "Bearer {{ access_token }}" }
    ]
    response: {
      http_status: 200
      expect_all: {
        conditions: [
          { body: {} contains: "\"realm\":\"master\"" }
        ]
      }
    }
  }
}

#############
# WORKFLOWS #
#############

workflows: {
  actions: [
    "check_keycloak",
    "attempt_login",
    "verify_login"
  ]
}
