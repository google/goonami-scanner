# proto-file: goonami/core/config/config.proto
# proto-message: goonami.proto.Config

workflowcfg: {
  # port scanner
  portscan: "ps/nmap"

  # fingerprinters, we want to preserve order.
  fingerprinters: {
    require: "fp/sslsupport"
    require: "fp/iswebservice"
    require: "fp/webidentity"
    require: ".*"
  }

  # detectors
  detectors: {
    require: ".*"
  }
}

globalcfg: {
  performance: {
    max_concurrency: 10
    timeout_per_request_seconds: 15
    max_packets_per_second: 0  # no limit
    max_http_requests_per_second: 0  # no limit
  }

  user_agent: "GoonamiScanner"

  # left empty so that it scans all ports.
  ports_to_scan: []
}

clients: {
  callback_server: {
    interaction_ttl_seconds: 300
    cleanup_interval_seconds: 10

    http_poll_config: {
      mode: MODE_START_LOCAL_SERVER
      public_uri: "http://127.0.0.1:8081"
      bind_address: "127.0.0.1"
      bind_port: 8081
    }

    http_record_config: {
      mode: MODE_START_LOCAL_SERVER
      public_uri: "http://127.0.0.1:8080"
      bind_address: "127.0.0.1"
      bind_port: 8080
    }

    # note that by default, the DNS callback server is disabled. Plugins that
    # rely on it will not work.
    dns_record_config: {
      mode: MODE_USE_REMOTE_SERVER
      public_uri: "cb.localhost"
    }
  }

  nmap: {
    timeout_seconds: 300

    scan_technique: CONNECT
    scan_intensity: 4
    enable_host_discovery: false

    # version detection
    enable_version_detection: false
    version_intensity: 5

    # scripts; requires version detection to be enabled.
    enable_http_methods_detection: false
    enable_ssl_detection: false
  }

  http_crawler: {
    max_concurrency: 3
    max_page_size_bytes: 5242880  # 5 MB
    max_depth: 1
    max_requests: 200

    # ensure the crawler does not perform any destructive actions.
    exclusions: [
      ".*abort.*",
      ".*delete.*",
      ".*drop.*",
      ".*huphuphup.*",
      ".*kill.*",
      ".*quit.*",
      ".*remove.*"
    ]
  }

  llm: {
    timeout_per_request_seconds: 240  # 4 minutes
    max_attempts: 3
    retry_delay_seconds: 10

    tools: {
      http_client_config: {
        allowed_methods: ["GET", "POST"]
        max_requests_per_service: 50
        max_answer_size_bytes: 1048576  # 1 MB
        forbidden_paths: [
          ".*abort.*",
          ".*delete.*",
          ".*drop.*",
          ".*huphuphup.*",
          ".*kill.*",
          ".*quit.*",
          ".*remove.*"
        ]
      }
    }
  }
}

plugins: {
  webidentity: {
    signatures_directory: "plugins/fingerprint/webidentity/fingerprints"
    write_html_to_file: true
    maximum_file_size_bytes: 512000  # 500 KB
    maximum_storage_space_bytes: 51200000  # 100 pages (~48 MB total)
  }

  templatedweakcredentials: {
    max_attempts_per_service: 100
    username_file: "plugins/detectors/templatedweakcredentials/data/usernames.txt"
    passwords_file: "plugins/detectors/templatedweakcredentials/data/passwords.txt"
  }
}
